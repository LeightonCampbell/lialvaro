---
import Layout from '../layouts/Layout.astro';
import Button from '../components/ds/Button.astro';
import Section from '../components/ds/Section.astro';
import StepList from '../components/ds/StepList.astro';
import ProductCard from '../components/ds/ProductCard.astro';
import ReviewCard from '../components/ds/ReviewCard.astro';
import Accordion from '../components/ds/Accordion.astro';
import { brand, claimText } from '../lib/claims';

const sameDay = claimText('same-day-printing');
const methods = claimText('methods-screen-dtg-dtf-embroidery');
const noMinimums = claimText('no-minimums');
const turnaround = claimText('turnaround-standard-5-7');
const phone = claimText('phone-310-904-2655') ?? 'Call (310) 904-2655.';

const steps = [
  { title: 'Start Designing', body: 'Open Design Studio, pick a product, and add your art.' },
  { title: 'Approve art & pricing', body: 'Confirm the proof and total before we print.' },
  { title: 'We print & deliver', body: 'We print and get it to you.' },
];

const reviews = [
  {
    name: 'Leighton C.',
    quote:
      "I had my logo designed and my t-shirts and polos printed here several years ago. Since then, I've had banners, posters, hats, and, many other products done by LTP (even ugly sweaters for Christmas of 2024). Li is so friendly and patient. I recommend LiAlvaro T-shirt Printing to everyone.",
  },
  {
    name: 'Mark L.',
    quote: 'I will never use another company for my Custom Printing needs. These guys do a wonderful job.',
  },
  {
    name: 'Richard L.',
    quote:
      'Truly 5 stars - This was so easy, even for my large, complicated order. Li at LiAlvaro T-shirt Printing guided me through the process and was super responsive to my questions. The shirts are comfortable, the design is perfect. We all love them. This was a great experience!',
  },
];

const faqItems = [
  {
    id: 'shop-vs-quote',
    question: 'Design Studio vs quote?',
    answer:
      'Design Studio is for orders you are ready to place. A quote is for bulk, specialty garments, or projects that need a custom plan.',
  },
  {
    id: 'minimums',
    question: 'Minimum order?',
    answer: noMinimums ?? 'Ask us about quantity for your project.',
  },
  {
    id: 'how-fast',
    question: 'How fast?',
    answer: [turnaround, sameDay].filter(Boolean).join(' ') || 'Call us to confirm timing for your order.',
  },
];

const localBusiness = {
  '@context': 'https://schema.org',
  '@type': 'LocalBusiness',
  name: brand,
  url: 'https://www.lialvaro.com/',
  telephone: '+1-310-904-2655',
  email: 'help@lialvaro.com',
  address: {
    '@type': 'PostalAddress',
    addressLocality: 'Los Angeles',
    addressRegion: 'CA',
    addressCountry: 'US',
  },
  areaServed: 'Los Angeles',
  description:
    'Custom apparel printing in Los Angeles — screen printing, DTG, DTF, and embroidery. Design online or request a quote.',
};

const faqPageLd = {
  '@context': 'https://schema.org',
  '@type': 'FAQPage',
  mainEntity: faqItems.map((item) => ({
    '@type': 'Question',
    name: item.question,
    acceptedAnswer: { '@type': 'Answer', text: item.answer },
  })),
};
---

<Layout
  title="Custom T-Shirt Printing in Los Angeles"
  description="Custom printed apparel with a clear process. Design online or request a quote. LiAlvaro T-Shirt Printing — Los Angeles."
  keywords="custom t-shirt printing Los Angeles, screen printing, DTG, DTF, embroidery"
  jsonLd={[localBusiness, faqPageLd]}
>
  <section class="home-hero">
    <div class="home-hero__copy">
      <p class="eyebrow">LiAlvaro · Los Angeles{methods ? ` · ${methods}` : ''}</p>
      <h1>Fast, Top-Quality Custom Apparel Printing.</h1>
      <p class="home-hero__sub">
        Start Designing in our Design Studio, or get a free quote for custom and bulk work.
        {sameDay ? ` ${sameDay}` : ''}
      </p>
      <div class="home-hero__ctas">
        <Button href="/design/">Start Designing</Button>
        <button type="button" class="ds-btn ds-btn--secondary" data-quote-trigger>Get a free quote</button>
      </div>
    </div>
    <div class="home-hero__visual" role="img" aria-label="Custom apparel printing">
      <img
        src="/images/homepage-hero-2.jpg"
        alt=""
        width="1200"
        height="800"
        fetchpriority="high"
        decoding="async"
      />
    </div>
  </section>

  <div class="page-shell home-sections">
    <Section eyebrow="How it works" title="Three steps. No runaround.">
      <StepList steps={steps} />
      <div class="section-cta">
        <Button href="/design/">Start Designing</Button>
        <button type="button" class="linkish" data-quote-trigger>Get a quote</button>
      </div>
    </Section>

    <Section eyebrow="Store" title="Standard products with clear pricing.">
      <p slot="lede">Browse ready-to-order items. Custom and bulk jobs use a quote instead.</p>
      <div class="product-grid">
        <ProductCard empty />
      </div>
      <div class="section-cta">
        <Button href="/shop/">Browse the store →</Button>
      </div>
    </Section>

    <Section eyebrow="Services" title="The right method for the job." id="services">
      <p slot="lede">
        {methods
          ? `${methods} Tell us about quantity, garment, and timing — we’ll recommend a path.`
          : 'Tell us about quantity, garment, and timing — we’ll recommend a path.'}
      </p>
      <div class="method-grid">
        <button type="button" class="method-card" data-quote-trigger data-quote-service="Screen Printing">Screen Printing</button>
        <button type="button" class="method-card" data-quote-trigger data-quote-service="Direct to Garment">DTG</button>
        <button type="button" class="method-card" data-quote-trigger data-quote-service="Direct to Film">DTF</button>
        <button type="button" class="method-card" data-quote-trigger data-quote-service="Embroidery">Embroidery</button>
      </div>
      <div class="section-cta">
        <button type="button" class="ds-btn ds-btn--primary" data-quote-trigger>Get a custom quote →</button>
      </div>
    </Section>

    <Section eyebrow="Customer reviews" title="What people say.">
      <div class="review-grid">
        {reviews.map((review) => <ReviewCard quote={review.quote} name={review.name} />)}
      </div>
    </Section>

    <Section eyebrow="FAQ" title="Quick answers" id="faq">
      <Accordion items={faqItems} />
      <div class="section-cta">
        <Button href="/faq/">View the full FAQ →</Button>
      </div>
    </Section>

    <section class="final-cta">
      <h2>Ready when you are.</h2>
      <p>Questions? Call us — we’re happy to help.</p>
      <div class="section-cta">
        <button type="button" class="ds-btn ds-btn--primary" data-quote-trigger>Get a free quote →</button>
        <Button variant="secondary" href="tel:3109042655">{phone}</Button>
      </div>
    </section>
  </div>
</Layout>

<style>
  .home-hero {
    display: grid;
    gap: 0;
    background: var(--ink);
    color: var(--white);
  }

  @media (min-width: 900px) {
    .home-hero {
      grid-template-columns: 1.05fr 1fr;
      min-height: min(78vh, 720px);
    }
  }

  .home-hero__copy {
    padding: clamp(2rem, 5vw, 4rem) clamp(1rem, 4vw, 3rem);
    display: grid;
    align-content: center;
    gap: 0.75rem;
  }

  .home-hero__copy .eyebrow {
    color: var(--gold);
  }

  .home-hero h1 {
    margin: 0;
    font-family: var(--font-display);
    font-size: clamp(2.2rem, 5.5vw, 3.6rem);
    font-weight: 400;
    letter-spacing: 0.02em;
    text-transform: uppercase;
    line-height: 0.98;
  }

  .home-hero__sub {
    margin: 0;
    max-width: 36rem;
    color: color-mix(in srgb, var(--white) 82%, var(--mesh-grey));
  }

  .home-hero__ctas {
    display: flex;
    flex-wrap: wrap;
    gap: 0.75rem;
    margin-top: 0.5rem;
  }

  .home-hero__ctas :global(.ds-btn--ghost) {
    color: var(--white);
  }

  .home-hero__ctas .ds-btn--secondary {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    min-height: 44px;
    padding: 0.7rem 1.15rem;
    border: 2px solid var(--white);
    border-radius: var(--radius-md);
    background: transparent;
    color: var(--white);
    font-family: var(--font-body);
    font-size: var(--text-sm);
    font-weight: 700;
    cursor: pointer;
  }

  .home-hero__visual {
    min-height: 240px;
    overflow: hidden;
  }

  .home-hero__visual img {
    display: block;
    width: 100%;
    height: 100%;
    object-fit: cover;
  }

  .home-sections :global(.ds-section) {
    padding-block: 2.5rem;
  }

  .section-cta {
    display: flex;
    flex-wrap: wrap;
    gap: 0.75rem;
    margin-top: 1.25rem;
  }

  .product-grid,
  .method-grid,
  .review-grid {
    display: grid;
    gap: 1rem;
  }

  @media (min-width: 768px) {
    .method-grid,
    .review-grid {
      grid-template-columns: repeat(3, 1fr);
    }

    .method-grid {
      grid-template-columns: repeat(4, 1fr);
    }
  }

  .method-card {
    border: 1px solid var(--color-border-strong);
    background: var(--white);
    border-radius: var(--radius-md);
    padding: 1.25rem 1rem;
    font: inherit;
    font-weight: 700;
    text-align: center;
    cursor: pointer;
    color: inherit;
    min-height: 44px;
  }

  .method-card:hover {
    border-color: var(--print-red);
  }

  .method-card:focus-visible {
    outline: 3px solid var(--color-focus);
    outline-offset: 2px;
  }

  .linkish {
    background: none;
    border: none;
    color: var(--print-red);
    font: inherit;
    font-weight: 700;
    text-decoration: underline;
    cursor: pointer;
    min-height: 44px;
  }

  .section-cta .ds-btn--primary {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    min-height: 44px;
    padding: 0.7rem 1.15rem;
    border: 2px solid var(--print-red);
    border-radius: var(--radius-md);
    background: var(--print-red);
    color: var(--white);
    font-family: var(--font-body);
    font-size: var(--text-sm);
    font-weight: 700;
    cursor: pointer;
  }

  .final-cta {
    margin: 2rem 0 1rem;
    padding: 2rem 1.25rem;
    text-align: center;
    background: var(--white);
    border: 1px solid var(--color-border-strong);
    border-radius: var(--radius-lg);
  }

  .final-cta h2 {
    margin: 0;
    font-family: var(--font-display);
    font-size: var(--text-3xl);
    font-weight: 400;
    text-transform: uppercase;
  }

  .final-cta p {
    margin: 0.5rem auto 0;
    max-width: 36rem;
    color: color-mix(in srgb, var(--ink) 80%, var(--mesh-grey));
  }

  .final-cta .section-cta {
    justify-content: center;
  }

  .final-cta .ds-btn--primary {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    min-height: 44px;
    padding: 0.7rem 1.15rem;
    border: 2px solid var(--print-red);
    border-radius: var(--radius-md);
    background: var(--print-red);
    color: var(--white);
    font-family: var(--font-body);
    font-size: var(--text-sm);
    font-weight: 700;
    cursor: pointer;
  }
</style>

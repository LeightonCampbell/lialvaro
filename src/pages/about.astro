---
import Layout from '../layouts/Layout.astro';
import Button from '../components/ds/Button.astro';
import Section from '../components/ds/Section.astro';
import { brand } from '../lib/claims';
---

<Layout
  title="About"
  description={`The story behind ${brand} — custom apparel printing in Los Angeles since 2020.`}
>
  <div class="page-shell">
    <header class="page-hero">
      <p class="eyebrow">About</p>
      <h1>The story behind the print.</h1>
      <p>Born in Los Angeles, LiAlvaro was founded by people who care about clear process and durable results.</p>
    </header>

    <Section eyebrow="Our story" title="Los Angeles custom apparel" cutline={false}>
      <div class="prose">
        <p>
          LiAlvaro T-Shirt Printing has served Los Angeles with custom printing and embroidery since 2020. We help
          individuals, teams, and businesses get apparel that matches their brand — from single pieces to larger runs.
        </p>
        <p>
          Whether you need a statement tee, event merch, or branded workwear, we will help you choose the right method
          and path: design online when that fits, or request a quote for custom and bulk work.
        </p>
        <div class="actions">
          <Button href="/design/">Start Designing</Button>
          <button type="button" class="linkish" data-quote-trigger>Get a free quote</button>
        </div>
      </div>
    </Section>

    <Section eyebrow="Vision" title="Your story, in print">
      <div class="prose">
        <p>
          From streetwear to embroidery, we help bridge the gap between idea and finished garment. You bring the story —
          we help you get it onto apparel with a clear process.
        </p>
        <p>
          We will keep helping you tell that story, project by project — for brands, events, and anything important
          enough to call yours.
        </p>
      </div>
    </Section>
  </div>
</Layout>

<style>
  .prose {
    max-width: 42rem;
    display: grid;
    gap: 1rem;
  }

  .prose p {
    margin: 0;
    color: color-mix(in srgb, var(--ink) 85%, var(--mesh-grey));
  }

  .actions {
    display: flex;
    flex-wrap: wrap;
    gap: 0.75rem;
    align-items: center;
  }

  .linkish {
    background: none;
    border: none;
    color: var(--print-red);
    font: inherit;
    font-weight: 700;
    text-decoration: underline;
    text-underline-offset: 3px;
    cursor: pointer;
    min-height: 44px;
  }
</style>

---
import Layout from "../layouts/Layout.astro";
import RegMark from "../components/RegMark.astro";

const products = [
  {
    name: "Single Tee — DTG Print",
    meta: "Your design · 1 piece",
    price: "$24",
    photo: "/images/dtg.jpg",
    photoAlt: "Direct-to-garment printed t-shirt",
    service: "Direct to Garment",
  },
  {
    name: "Embroidered Cap",
    meta: "Up to 5,000 stitches",
    price: "$28",
    photo: "/images/Embroidery.jpg",
    photoAlt: "Custom embroidered cap",
    service: "Embroidery",
  },
  {
    name: "5-Pack Tees — Screen Print",
    meta: "1 design, 1 color",
    price: "$95",
    photo: "/images/screenprinting.jpg",
    photoAlt: "Screen printed t-shirt stack",
    service: "Screen Printing",
  },
  {
    name: "Hoodie — DTF Print",
    meta: "Your design · 1 piece",
    price: "$42",
    photo: "/images/DTF.jpg",
    photoAlt: "DTF printed hoodie",
    service: "Direct to Film",
  },
  {
    name: "Polo — Embroidery",
    meta: "Left chest logo",
    price: "$35",
    photo: "/images/silkscreen.jpg",
    photoAlt: "Embroidered polo shirt",
    service: "Embroidery",
  },
  {
    name: "Tote Bag — DTG Print",
    meta: "Your design · 1 piece",
    price: "$18",
    photo: "/images/wolf.jpg",
    photoAlt: "DTG printed tote bag",
    service: "Direct to Garment",
  },
];

const services = [
  {
    tag: "Most Popular",
    name: "Silkscreen Printing",
    desc: "The gold standard for bulk apparel. Crisp, durable ink at the best price-per-piece for larger quantities.",
    hrefLabel: "Get screen printing →",
    service: "Screen Printing",
  },
  {
    tag: "No Minimums",
    name: "Direct To Garment",
    desc: "Vibrant, photo-realistic graphics printed directly onto your garment. No setup fees.",
    hrefLabel: "Print with DTG →",
    service: "Direct to Garment",
  },
  {
    tag: "Best Durability",
    name: "Direct To Film",
    desc: "Prints that bond to virtually any fabric. Exceptional durability and color, wash after wash.",
    hrefLabel: "Start DTF printing →",
    service: "Direct to Film",
  },
  {
    tag: "Premium Finish",
    name: "Custom Embroidery",
    desc: "Professional, tactile stitching for hats, polos, jackets, and premium outerwear.",
    hrefLabel: "Get embroidery →",
    service: "Embroidery",
  },
];

const reviews = [
  {
    body: "I had my logo designed and my t-shirts and polos printed here several years ago. Since then, I've had banners, posters, hats, and many other products done by LiAlvaro (even ugly sweaters for Christmas of 2024). Li is so friendly and patient. I recommend LiAlvaro to everyone.",
    name: "Leighton C.",
  },
  {
    body: "I will never use another company for my custom printing needs. These guys do a wonderful job.",
    name: "Mark L.",
  },
  {
    body: "Truly 5 stars — this was so easy, even for my large, complicated order. Li guided me through the process and was super responsive. The shirts are comfortable, the design is perfect.",
    name: "Richard L.",
  },
];
---

<Layout
  title="LiAlvaro Apparel — Custom Printing, Los Angeles"
  exactTitle
  home
  description="LiAlvaro Apparel — Los Angeles' premier custom apparel printer. Screen printing, DTG, DTF, embroidery. No minimums. Same-day service. Call (310) 904-2655."
  keywords="custom t-shirts Los Angeles, screen printing LA, DTG printing, custom embroidery, custom hoodies, same day printing Los Angeles"
  faqHref="/faq"
>
  <div class="home" id="top">
    <section class="hero">
      <div class="wrap hero-grid">
        <div>
          <span class="eyebrow">Los Angeles · Screen Print · DTG · DTF · Embroidery</span>
          <h1>Custom Printed.<br /><em>Same Day Ready.</em></h1>
          <p>
            Professional print quality with no minimums — shop standard prints instantly, or get a custom quote for bulk and
            complex orders.
          </p>
          <div class="hero-ctas">
            <a class="btn btn-primary" href="#store">Shop Standard Prints →</a>
            <button type="button" class="btn btn-ghost" data-quote-trigger>Get a Custom Quote</button>
          </div>
          <div class="badges">
            <div class="badge"><span class="num">No Min.</span><span class="lbl">Order quantity</span></div>
            <div class="badge"><span class="num">Same-Day</span><span class="lbl">Available in LA</span></div>
            <div class="badge"><span class="num">24/7</span><span class="lbl">Team support</span></div>
          </div>
        </div>
        <div class="swatch-photo">
          <RegMark class="rm-tl" />
          <RegMark class="rm-tr" />
          <RegMark class="rm-bl" />
          <RegMark class="rm-br" />
          <img src="/images/homepage-hero-2.jpg" alt="Finished custom printed apparel from LiAlvaro" />
        </div>
      </div>
    </section>

    <section class="store" id="store">
      <div class="wrap">
        <div class="section-head">
          <span class="eyebrow">Instant Checkout</span>
          <h2>Shop standard prints.</h2>
          <p>Ready-to-order items with fixed pricing — no quote needed. Checkout instantly, we print and ship or you pick up locally.</p>
        </div>
        <div class="store-grid">
          {
            products.map((product) => (
              <article class="tag-card">
                <div class="tag-photo">
                  <div class="tag-hole"></div>
                  <img src={product.photo} alt={product.photoAlt} />
                </div>
                <div class="tag-body">
                  <div>
                    <div class="tag-name">{product.name}</div>
                    <div class="tag-meta">{product.meta}</div>
                  </div>
                  <div class="tag-row">
                    <span class="tag-price">{product.price}</span>
                    <button
                      type="button"
                      class="btn btn-primary btn-sm"
                      data-quote-trigger
                      data-quote-service={product.service}
                    >
                      Add
                    </button>
                  </div>
                </div>
              </article>
            ))
          }
        </div>
      </div>
    </section>

    <section id="services">
      <div class="wrap">
        <div class="section-head">
          <span class="eyebrow">Bulk &amp; Custom Work</span>
          <h2>Every print method, under one roof.</h2>
        </div>
        <div class="services-grid">
          {
            services.map((item) => (
              <article class="service-card">
                <span class="service-tag">{item.tag}</span>
                <h3>{item.name}</h3>
                <p>{item.desc}</p>
                <button type="button" class="service-link" data-quote-trigger data-quote-service={item.service}>
                  {item.hrefLabel}
                </button>
              </article>
            ))
          }
        </div>
      </div>
    </section>

    <section id="about">
      <div class="wrap story">
        <div>
          <span class="eyebrow">Our Story</span>
          <h2 class="story-title">We're not just another print shop.</h2>
          <p class="story-body">
            We started LiAlvaro Apparel to make premium custom printing accessible to everyone — no complicated processes, no
            hidden fees. We're open about everything, dedicated to ethical practices, and always just a phone call away.
          </p>
          <ul class="trust-list">
            <li>
              <span>💵</span>
              <span>
                <strong>Transparent pricing</strong> — standard items shown above, custom quotes explained line-by-line, no
                surprise fees
              </span>
            </li>
            <li>
              <span>🌱</span>
              <span><strong>Ethical practices</strong> — sourced and printed responsibly</span>
            </li>
            <li>
              <span>📞</span>
              <span><strong>Always reachable</strong> — real humans, 24/7 support</span>
            </li>
            <li>
              <span>🎨</span>
              <span><strong>Design assistance</strong> — we'll help perfect your artwork</span>
            </li>
          </ul>
        </div>
        <div>
          <div class="swatch-photo swatch-square">
            <img src="/images/screenprinting.jpg" alt="LiAlvaro print shop floor" />
          </div>
          <div class="stat-row">
            <div class="stat">
              <div class="num">12+</div>
              <div class="lbl">Min qty for bulk pricing</div>
            </div>
            <div class="stat">
              <div class="num">5–7</div>
              <div class="lbl">Day standard turnaround</div>
            </div>
            <div class="stat">
              <div class="num">Same Day</div>
              <div class="lbl">Rush service in LA</div>
            </div>
          </div>
        </div>
      </div>
    </section>

    <section>
      <div class="wrap">
        <div class="section-head">
          <span class="eyebrow">Real Google Reviews</span>
          <h2>What our customers are saying.</h2>
        </div>
        <div class="reviews-grid">
          {
            reviews.map((review) => (
              <article class="review-card">
                <span class="stars">★★★★★</span>
                <p>{review.body}</p>
                <span class="review-name">{review.name}</span>
              </article>
            ))
          }
        </div>
      </div>
    </section>

    <section id="faq">
      <div class="wrap">
        <div class="section-head">
          <span class="eyebrow">FAQ</span>
          <h2>Frequently asked questions.</h2>
        </div>
        <div class="faq-list">
          <details class="faq-item" open>
            <summary>What's the difference between the shop and a custom quote?</summary>
            <p>
              The shop is for standard, ready-to-order items with fixed pricing — checkout instantly. A custom quote is for bulk
              orders, unusual garments, or complex multi-color designs that need a bit of back-and-forth first.
            </p>
          </details>
          <details class="faq-item">
            <summary>What's the minimum order quantity?</summary>
            <p>
              No minimum. You can order a single shirt in the shop. Bulk pricing on screen printing kicks in at 12+ pieces via a
              custom quote.
            </p>
          </details>
          <details class="faq-item">
            <summary>How long does it take to get my order?</summary>
            <p>
              Standard turnaround is 5–7 business days after artwork approval and payment. Rush orders (4 business days) are
              available for a fee. Same-day service available locally in LA.
            </p>
          </details>
          <details class="faq-item">
            <summary>Do I need to create my own design?</summary>
            <p>Not at all. We accept .ai, .png, .jpg, or .svg files, and can edit or create a design for you at a small cost.</p>
          </details>
        </div>
        <p class="faq-see-all">
          <a href="/faq">View the complete FAQ →</a>
        </p>
      </div>
    </section>

    <section>
      <div class="wrap">
        <div class="cta-band">
          <h2>Ready to make something incredible?</h2>
          <p>Shop standard prints instantly, or call for a custom quote — we're available 24/7.</p>
          <div class="cta-actions">
            <a class="btn btn-cta-light" href="#store">Shop Now →</a>
            <a class="btn btn-ghost" href="tel:3109042655">Call (310) 904-2655</a>
          </div>
        </div>
      </div>
    </section>
  </div>
</Layout>

<style is:global>
  .theme-home .home {
    color: var(--ink-soft);
    font-family: var(--font-sans);
  }

  .theme-home .home h1,
  .theme-home .home h2,
  .theme-home .home h3 {
    font-family: var(--font-display);
    font-weight: 400;
    text-transform: uppercase;
    letter-spacing: 0.01em;
    color: var(--ink);
    margin: 0;
    line-height: 0.98;
  }

  .theme-home .home p {
    font-size: 16px;
    line-height: 1.55;
    color: var(--ink-soft);
  }

  .theme-home .home .wrap {
    max-width: var(--maxw);
    margin: 0 auto;
    padding: 0 24px;
  }

  .theme-home .home .eyebrow {
    font-family: var(--font-mono);
    font-size: 12px;
    letter-spacing: 0.14em;
    text-transform: uppercase;
    color: var(--brand-red);
    font-weight: 600;
  }

  .theme-home .home .btn {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    gap: 8px;
    font-family: var(--font-mono);
    font-size: 13px;
    font-weight: 600;
    letter-spacing: 0.03em;
    text-transform: uppercase;
    padding: 12px 22px;
    border-radius: var(--print-radius);
    border: 2px solid var(--ink);
    cursor: pointer;
    text-decoration: none;
    transition:
      transform 0.15s ease,
      background 0.15s ease,
      color 0.15s ease;
    background: transparent;
    color: var(--ink);
  }

  .theme-home .home .btn:focus-visible {
    outline: 3px solid var(--brand-red);
    outline-offset: 2px;
  }

  .theme-home .home .btn-primary {
    background: var(--brand-red);
    border-color: var(--brand-red);
    color: var(--paper);
  }

  .theme-home .home .btn-primary:hover {
    background: #a80d26;
    color: var(--paper);
    transform: translateY(-1px);
  }

  .theme-home .home .btn-ghost:hover {
    background: var(--ink);
    color: var(--canvas);
  }

  .theme-home .home .btn-sm {
    padding: 9px 16px;
    font-size: 12px;
  }

  .theme-home .home section {
    padding: 64px 0;
  }

  .theme-home .home .section-head {
    max-width: 640px;
    margin-bottom: 44px;
  }

  .theme-home .home .section-head h2 {
    font-size: clamp(30px, 4vw, 44px);
    margin: 12px 0 0;
  }

  .theme-home .home .hero {
    padding: 72px 0 56px;
  }

  .theme-home .home .hero-grid {
    display: grid;
    grid-template-columns: 1.1fr 1fr;
    gap: 56px;
    align-items: center;
  }

  .theme-home .home .hero h1 {
    font-size: clamp(40px, 6vw, 74px);
    line-height: 0.98;
    margin: 14px 0 20px;
  }

  .theme-home .home .hero h1 em {
    font-style: normal;
    color: var(--brand-red);
  }

  .theme-home .home .hero p {
    font-size: 18px;
    max-width: 46ch;
    margin: 0 0 28px;
  }

  .theme-home .home .hero-ctas {
    display: flex;
    gap: 14px;
    flex-wrap: wrap;
    margin-bottom: 36px;
  }

  .theme-home .home .badges {
    display: flex;
    gap: 28px;
    flex-wrap: wrap;
  }

  .theme-home .home .badge {
    display: flex;
    flex-direction: column;
  }

  .theme-home .home .badge .num {
    font-family: var(--font-display);
    font-size: 26px;
    color: var(--ink);
    text-transform: uppercase;
  }

  .theme-home .home .badge .lbl {
    font-family: var(--font-mono);
    font-size: 11px;
    letter-spacing: 0.08em;
    text-transform: uppercase;
    color: var(--mesh);
  }

  .theme-home .home .swatch-photo {
    position: relative;
    aspect-ratio: 4 / 5;
    background:
      repeating-linear-gradient(45deg, rgba(27, 34, 51, 0.05) 0 2px, transparent 2px 14px),
      var(--canvas-2);
    border: 2px solid var(--ink);
    border-radius: var(--print-radius);
    overflow: hidden;
  }

  .theme-home .home .swatch-photo img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    display: block;
  }

  .theme-home .home .swatch-photo .regmark,
  .theme-home .home .swatch-photo :global(.regmark) {
    position: absolute;
    color: var(--paper);
    opacity: 0.85;
    z-index: 1;
    mix-blend-mode: difference;
  }

  .theme-home .home .rm-tl { top: 14px; left: 14px; }
  .theme-home .home .rm-tr { top: 14px; right: 14px; }
  .theme-home .home .rm-bl { bottom: 14px; left: 14px; }
  .theme-home .home .rm-br { bottom: 14px; right: 14px; }

  .theme-home .home .swatch-square {
    aspect-ratio: 1 / 1;
  }

  .theme-home .home .store {
    background: var(--ink);
  }

  .theme-home .home .store .eyebrow {
    color: var(--gold);
  }

  .theme-home .home .store .section-head h2 {
    color: var(--canvas);
  }

  .theme-home .home .store .section-head p {
    color: #b7bac4;
    margin: 12px 0 0;
  }

  .theme-home .home .store-grid {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: 22px;
  }

  .theme-home .home .tag-card {
    background: var(--canvas);
    border-radius: var(--print-radius);
    overflow: hidden;
    display: flex;
    flex-direction: column;
    transition: transform 0.18s ease;
  }

  .theme-home .home .tag-card:hover {
    transform: translateY(-4px);
  }

  .theme-home .home .tag-photo {
    position: relative;
    aspect-ratio: 1 / 1;
    background:
      repeating-linear-gradient(-45deg, rgba(27, 34, 51, 0.06) 0 2px, transparent 2px 14px),
      var(--canvas-2);
    border-bottom: 2px dashed var(--mesh);
    overflow: hidden;
  }

  .theme-home .home .tag-photo img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    display: block;
  }

  .theme-home .home .tag-hole {
    position: absolute;
    top: 12px;
    left: 12px;
    width: 14px;
    height: 14px;
    border-radius: 50%;
    background: var(--canvas);
    border: 2px solid var(--ink);
    z-index: 1;
  }

  .theme-home .home .tag-body {
    padding: 18px 18px 20px;
    display: flex;
    flex-direction: column;
    gap: 10px;
    flex: 1;
  }

  .theme-home .home .tag-name {
    font-size: 16px;
    font-weight: 700;
    color: var(--ink);
    font-family: var(--font-sans);
  }

  .theme-home .home .tag-meta {
    font-family: var(--font-mono);
    font-size: 11px;
    color: var(--mesh);
    text-transform: uppercase;
    letter-spacing: 0.04em;
    margin-top: 4px;
  }

  .theme-home .home .tag-row {
    display: flex;
    align-items: center;
    justify-content: space-between;
    margin-top: auto;
    padding-top: 6px;
  }

  .theme-home .home .tag-price {
    font-family: var(--font-mono);
    font-size: 18px;
    font-weight: 600;
    color: var(--ink);
  }

  .theme-home .home .services-grid {
    display: grid;
    grid-template-columns: repeat(4, 1fr);
    gap: 20px;
  }

  .theme-home .home .service-card {
    background: var(--paper);
    border: 1px solid rgba(27, 34, 51, 0.12);
    border-radius: var(--print-radius);
    padding: 26px 22px;
    display: flex;
    flex-direction: column;
    gap: 14px;
  }

  .theme-home .home .service-tag {
    font-family: var(--font-mono);
    font-size: 10px;
    letter-spacing: 0.1em;
    text-transform: uppercase;
    color: var(--brand-red);
  }

  .theme-home .home .service-card h3 {
    font-size: 20px;
    line-height: 1.1;
  }

  .theme-home .home .service-card p {
    font-size: 14px;
    color: var(--mesh);
    margin: 0;
    flex: 1;
  }

  .theme-home .home .service-link {
    font-family: var(--font-mono);
    font-size: 12px;
    font-weight: 600;
    color: var(--ink);
    display: inline-flex;
    align-items: center;
    gap: 6px;
    background: none;
    border: 0;
    padding: 0;
    cursor: pointer;
    text-align: left;
  }

  .theme-home .home .service-link:hover {
    color: var(--brand-red);
  }

  .theme-home .home .story {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 56px;
    align-items: start;
  }

  .theme-home .home .story-title {
    margin-top: 12px;
    font-size: clamp(30px, 4vw, 44px);
  }

  .theme-home .home .story-body {
    margin-top: 16px;
  }

  .theme-home .home .trust-list {
    list-style: none;
    margin: 24px 0 0;
    padding: 0;
    display: flex;
    flex-direction: column;
    gap: 14px;
  }

  .theme-home .home .trust-list li {
    display: flex;
    gap: 12px;
    font-size: 15px;
    color: var(--ink-soft);
  }

  .theme-home .home .trust-list strong {
    color: var(--ink);
  }

  .theme-home .home .stat-row {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: 20px;
    margin-top: 8px;
  }

  .theme-home .home .stat {
    border-top: 2px solid var(--ink);
    padding-top: 12px;
  }

  .theme-home .home .stat .num {
    font-family: var(--font-display);
    font-size: 34px;
    color: var(--brand-red);
    text-transform: uppercase;
    line-height: 1;
  }

  .theme-home .home .stat .lbl {
    font-family: var(--font-mono);
    font-size: 11px;
    letter-spacing: 0.06em;
    text-transform: uppercase;
    color: var(--mesh);
    margin-top: 4px;
  }

  .theme-home .home .reviews-grid {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: 20px;
  }

  .theme-home .home .review-card {
    background: var(--paper);
    border: 1px solid rgba(27, 34, 51, 0.12);
    border-radius: var(--print-radius);
    padding: 22px;
    display: flex;
    flex-direction: column;
    gap: 12px;
  }

  .theme-home .home .stars {
    color: var(--gold);
    font-size: 14px;
    letter-spacing: 2px;
  }

  .theme-home .home .review-card p {
    font-size: 14px;
    margin: 0;
    flex: 1;
  }

  .theme-home .home .review-name {
    font-family: var(--font-mono);
    font-size: 12px;
    color: var(--mesh);
  }

  .theme-home .home .faq-list {
    display: flex;
    flex-direction: column;
    border-top: 1px solid rgba(27, 34, 51, 0.14);
  }

  .theme-home .home .faq-item {
    border-bottom: 1px solid rgba(27, 34, 51, 0.14);
  }

  .theme-home .home .faq-item summary {
    list-style: none;
    cursor: pointer;
    display: flex;
    align-items: center;
    justify-content: space-between;
    padding: 20px 4px;
    font-weight: 700;
    color: var(--ink);
    font-size: 15px;
    font-family: var(--font-sans);
  }

  .theme-home .home .faq-item summary::-webkit-details-marker {
    display: none;
  }

  .theme-home .home .faq-item summary::after {
    content: "+";
    font-family: var(--font-mono);
    font-size: 20px;
    color: var(--brand-red);
    transition: transform 0.2s ease;
  }

  .theme-home .home .faq-item[open] summary::after {
    transform: rotate(45deg);
  }

  .theme-home .home .faq-item p {
    margin: 0 0 20px;
    padding: 0 4px;
    font-size: 14px;
    color: var(--mesh);
    max-width: 64ch;
  }

  .theme-home .home .faq-see-all {
    margin: 28px 0 0;
  }

  .theme-home .home .faq-see-all a {

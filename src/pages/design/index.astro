---
import Layout from '../../layouts/Layout.astro';
import { claimText } from '../../lib/claims';
import { getStudioConfig, studioUnitPriceCents } from '../../lib/design-studio';

const phone = claimText('phone-310-904-2655') ?? 'Call (310) 904-2655.';
const sameDay = claimText('same-day-printing');
const studio = getStudioConfig();
const priceMap = Object.fromEntries(studio.products.map((p) => [p.id, studioUnitPriceCents(p.id)]));
---

<Layout
  title="Design Studio"
  description="Design Studio at LiAlvaro T-Shirt Printing. Design on a blank, export print-ready art, and checkout."
>
  <div
    class="page-shell studio"
    id="designStudioRoot"
    data-studio
    data-price-map={JSON.stringify(priceMap)}
  >
    <header class="page-hero studio-hero">
      <p class="eyebrow">Design Studio</p>
      <h1>Design Studio</h1>
      <p>
        Ready to order? Pick a blank, design on front/back, export print-ready PNG, and checkout.
        {sameDay ? ` ${sameDay}` : ''}
      </p>
      <p class="hero-note">
        Custom / bulk / specialty jobs still use <button type="button" class="linkish" data-quote-trigger>Get a quote</button>.
      </p>
    </header>

    <section class="studio-layout" aria-label="Design studio editor">
      <aside class="studio-rail">
        <h2>Product</h2>
        <div id="productButtons" class="product-buttons"></div>

        <h2>Color</h2>
        <div id="colorButtons" class="swatches"></div>

        <h2>Placement</h2>
        <div id="sideButtons" class="chips"></div>

        <h2>Tools</h2>
        <div class="tools">
          <button type="button" class="tool" id="btnUpload">Upload PNG/JPG/SVG</button>
          <input id="fileInput" type="file" accept="image/png,image/jpeg,image/svg+xml,.png,.jpg,.jpeg,.svg" hidden />
          <button type="button" class="tool" id="btnAddText">Add text</button>
          <label class="color-field">
            Text color
            <input id="textColor" type="color" value="#c8102e" />
          </label>
          <div class="tool-row">
            <button type="button" class="tool" id="btnUndo">Undo</button>
            <button type="button" class="tool" id="btnRedo">Redo</button>
          </div>
          <div class="tool-row">
            <button type="button" class="tool" id="btnForward">Layer up</button>
            <button type="button" class="tool" id="btnBack">Layer down</button>
          </div>
          <button type="button" class="tool" id="btnDelete">Delete selected</button>
        </div>
      </aside>

      <div class="studio-main">
        <div class="studio-stage" id="studioStage">
          <div class="studio-mockup" id="studioMockup" aria-hidden="true"></div>
          <div class="print-frame" id="printFrame">
            <canvas id="studioCanvas" width="360" height="480"></canvas>
          </div>
        </div>
        <p class="studio-status" id="studioStatus" role="status"></p>
        <ul class="studio-warnings" id="studioWarnings" hidden></ul>
      </div>

      <aside class="studio-checkout">
        <h2>Order</h2>
        <p class="price" id="studioPrice" data-cents={priceMap.studio_tee ?? 0}>—</p>
        <p class="fine">
          Server validates price and files at export. LiAlvaro prints and fulfills — no external POD widget.
        </p>
        <label class="attest">
          <input id="ipAttest" type="checkbox" />
          <span>
            I confirm I own or have rights to this artwork, and I accept the
            <a href="/terms/">Terms</a> (report misuse via Contact).
          </span>
        </label>
        <button type="button" class="ds-btn ds-btn--primary" id="btnExport">Export &amp; add to cart</button>
        <p class="fine">
          Exports a print-ready PNG (300 DPI box) and saves your design session. Questions? {phone}
        </p>
        <a class="report" href="/contact/">Report / takedown request</a>
      </aside>
    </section>
  </div>
</Layout>

<script>
  import { initDesignStudio } from '../../scripts/design-studio-app.ts';
  initDesignStudio();
</script>

<style>
  .studio-hero .hero-note {
    margin: 0.75rem 0 0;
    color: color-mix(in srgb, var(--ink) 75%, var(--mesh-grey));
  }

  .linkish {
    background: none;
    border: none;
    color: var(--print-red);
    font: inherit;
    font-weight: 700;
    text-decoration: underline;
    cursor: pointer;
    padding: 0;
  }

  .studio-layout {
    display: grid;
    gap: 1.25rem;
    margin: 1rem 0 3rem;
  }

  @media (min-width: 960px) {
    .studio-layout {
      grid-template-columns: 240px minmax(0, 1fr) 240px;
      align-items: start;
    }
  }

  .studio-rail,
  .studio-checkout {
    display: grid;
    gap: 0.65rem;
    padding: 1rem;
    background: var(--white);
    border: 1px solid var(--color-border-strong);
    border-radius: var(--radius-lg);
  }

  .studio-rail h2,
  .studio-checkout h2 {
    margin: 0.35rem 0 0;
    font-family: var(--font-display);
    font-size: var(--text-lg);
    font-weight: 600;
    text-transform: uppercase;
  }

  .product-buttons {
    display: grid;
    gap: 0.5rem;
  }

  .product-chip,
  .tool,
  .chip {
    display: grid;
    gap: 0.15rem;
    width: 100%;
    text-align: left;
    border: 2px solid var(--ink);
    border-radius: var(--radius-md);
    background: var(--white);
    padding: 0.65rem 0.75rem;
    font: inherit;
    cursor: pointer;
    min-height: 44px;
  }

  .product-chip strong {
    font-weight: 700;
  }

  .product-chip span {
    font-size: 0.85rem;
    color: color-mix(in srgb, var(--ink) 70%, var(--mesh-grey));
  }

  .product-chip.is-active,
  .chip.is-active,
  .tool:hover {
    border-color: var(--print-red);
  }

  .swatches,
  .chips,
  .tool-row {
    display: flex;
    flex-wrap: wrap;
    gap: 0.5rem;
  }

  .swatch {
    width: 40px;
    height: 40px;
    border-radius: 999px;
    border: 2px solid var(--ink);
    cursor: pointer;
  }

  .swatch.is-active {
    outline: 3px solid var(--print-red);
    outline-offset: 2px;
  }

  .chip {
    width: auto;
    font-weight: 700;
  }

  .tools {
    display: grid;
    gap: 0.5rem;
  }

  .color-field {
    display: grid;
    gap: 0.25rem;
    font-size: 0.85rem;
    font-weight: 600;
  }

  .studio-main {
    display: grid;
    gap: 0.75rem;
  }

  .studio-stage {
    position: relative;
    min-height: 420px;
    border-radius: var(--radius-lg);
    overflow: hidden;
    border: 1px solid var(--color-border-strong);
    background: color-mix(in srgb, var(--canvas) 70%, var(--ink));
  }

  .studio-mockup {
    position: absolute;
    inset: 8% 18%;
    border-radius: 18% 18% 14% 14%;
    box-shadow: inset 0 0 0 2px color-mix(in srgb, var(--ink) 25%, transparent);
  }

  .print-frame {
    position: absolute;
    border: 1px dashed color-mix(in srgb, var(--white) 70%, var(--print-red));
    background: color-mix(in srgb, var(--white) 18%, transparent);
    touch-action: none;
  }

  .print-frame :global(canvas) {
    display: block;
    width: 100% !important;
    height: 100% !important;
  }

  .studio-status {
    margin: 0;
    font-weight: 600;
  }

  .studio-warnings {
    margin: 0;
    padding-left: 1.1rem;
    color: var(--color-danger);
  }

  .price {
    margin: 0;
    font-family: var(--font-mono);
    font-size: var(--text-xl);
    font-weight: 700;
  }

  .fine {
    margin: 0;
    font-size: var(--text-sm);
    color: color-mix(in srgb, var(--ink) 75%, var(--mesh-grey));
  }

  .attest {
    display: grid;
    grid-template-columns: auto 1fr;
    gap: 0.6rem;
    align-items: start;
    font-size: var(--text-sm);
  }

  .report {
    color: var(--print-red);
    font-weight: 700;
  }
</style>

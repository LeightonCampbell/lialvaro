---
interface Props {
	class?: string;
}

const { class: className } = Astro.props;
---

<svg class:list={["regmark", className]} viewBox="0 0 18 18" aria-hidden="true">
	<circle cx="9" cy="9" r="6"></circle>
	<line x1="9" y1="0" x2="9" y2="18"></line>
	<line x1="0" y1="9" x2="18" y2="9"></line>
</svg>

<style>
	.regmark {
		width: 18px;
		height: 18px;
		flex-shrink: 0;
	}

	.regmark circle {
		fill: none;
		stroke: currentColor;
		stroke-width: 1.4;
	}

	.regmark line {
		stroke: currentColor;
		stroke-width: 1.4;
	}
</style>

---
import '../styles/tokens.css';
import Header from '../components/ds/Header.astro';
import Footer from '../components/ds/Footer.astro';
import QuoteModal from '../components/QuoteModal.astro';
import { readSession, SESSION_COOKIE } from '../lib/auth';
import { brand } from '../lib/claims';

interface Props {
	title: string;
	description?: string;
	/** When true, `title` is used as the full document title. */
	exactTitle?: boolean;
	keywords?: string;
	jsonLd?: Record<string, unknown> | Record<string, unknown>[];
	noindex?: boolean;
}

const {
	title,
	description = 'Custom apparel printing in Los Angeles. Design online or request a quote for screen printing, DTG, DTF, and embroidery.',
	exactTitle = false,
	keywords,
	jsonLd,
	noindex = false,
} = Astro.props;

const documentTitle = exactTitle ? title : `${title} | ${brand}`;
const canonicalOrigin = 'https://www.lialvaro.com';
const normalizedPathname =
	Astro.url.pathname === '/'
		? '/'
		: Astro.url.pathname.endsWith('/')
			? Astro.url.pathname
			: `${Astro.url.pathname}/`;
const canonicalUrl = new URL(normalizedPathname, canonicalOrigin).toString();
const accountSession = await readSession(Astro.cookies.get(SESSION_COOKIE)?.value);
const jsonLdBlocks = jsonLd ? (Array.isArray(jsonLd) ? jsonLd : [jsonLd]) : [];
---

<!doctype html>
<html lang="en">
	<head>
		<meta charset="UTF-8" />
		<meta name="viewport" content="width=device-width, initial-scale=1.0" />
		<meta name="description" content={description} />
		{keywords ? <meta name="keywords" content={keywords} /> : null}
		{noindex ? <meta name="robots" content="noindex,nofollow" /> : <meta name="robots" content="index,follow" />}
		<link rel="icon" type="image/x-icon" href="/images/favicon.ico" />
		<meta name="generator" content={Astro.generator} />
		<title>{documentTitle}</title>
		<link rel="canonical" href={canonicalUrl} />
		<link rel="preload" href="/fonts/poppins-latin-700-normal.woff2" as="font" type="font/woff2" crossorigin />
		<link rel="preload" href="/fonts/inter-latin-400-normal.woff2" as="font" type="font/woff2" crossorigin />
		<link rel="preload" href="/fonts/inter-latin-700-normal.woff2" as="font" type="font/woff2" crossorigin />
		<meta property="og:type" content="website" />
		<meta property="og:site_name" content={brand} />
		<meta property="og:title" content={documentTitle} />
		<meta property="og:description" content={description} />
		<meta property="og:url" content={canonicalUrl} />
		<meta name="twitter:card" content="summary_large_image" />
		<meta name="twitter:title" content={documentTitle} />
		<meta name="twitter:description" content={description} />
		{
			jsonLdBlocks.map((block) => (
				<script type="application/ld+json" set:html={JSON.stringify(block)} />
			))
		}
		<slot name="head" />
	</head>
	<body class="site-body">
		<Header accountEmail={accountSession?.email} />
		<main id="main">
			<slot />
		</main>
		<Footer />
		<QuoteModal />
		<script>
			import { initAnalyticsScaffold, track } from '../scripts/analytics.ts';
			initAnalyticsScaffold();

			const storeQuoteEvent = (kind: string, extra: Record<string, unknown> = {}) => {
				fetch('/api/events', {
					method: 'POST',
					headers: { 'Content-Type': 'application/json' },
					body: JSON.stringify({ kind, ...extra }),
				}).catch(() => undefined);
			};

			document.addEventListener('click', (event) => {
				const target = event.target;
				if (!(target instanceof Element)) return;
				const quoteTrigger = target.closest('[data-quote-trigger]');
				if (quoteTrigger) {
					track('quote_started', { source: 'trigger' });
					storeQuoteEvent('quote_started', { source: 'trigger' });
				}
			});

			window.addEventListener('lialvaro:quote-step', ((event: CustomEvent) => {
				track('quote_step_N', { step: event.detail?.step });
				storeQuoteEvent('quote_step_N', { step: event.detail?.step });
			}) as EventListener);

			window.addEventListener('lialvaro:quote-submitted', (() => {
				track('quote_submitted');
				storeQuoteEvent('quote_submitted');
			}) as EventListener);

			window.addEventListener('lialvaro:design-started', (() => {
				track('design_started');
			}) as EventListener);
		</script>
	</body>
</html>

<style is:global>
	.site-body {
		margin: 0;
		min-height: 100vh;
		background: var(--canvas);
		color: var(--ink);
		font-family: var(--font-body);
		line-height: var(--leading-normal);
		-webkit-font-smoothing: antialiased;
	}

	.site-body a:focus-visible,
	.site-body button:focus-visible,
	.site-body summary:focus-visible,
	.site-body input:focus-visible,
	.site-body select:focus-visible,
	.site-body textarea:focus-visible {
		outline: 3px solid var(--color-focus);
		outline-offset: 2px;
	}

	.site-width,
	.page-shell {
		box-sizing: border-box;
		width: min(var(--site-max), calc(100% - 2 * var(--site-gutter)));
		max-width: none;
		margin-inline: auto;
		padding-inline: var(--site-pad);
	}

	.page-shell {
		padding-block: 2.5rem 4rem;
	}

	.page-hero {
		padding: 2.5rem 0 1.5rem;
	}

	h1,
	h2,
	h3,
	h4,
	h5,
	h6 {
		font-family: var(--font-display);
	}

	h1 {
		font-weight: 700;
	}

	h2,
	h3 {
		font-weight: 600;
	}

	h4,
	h5,
	h6 {
		font-weight: 500;
	}

	.page-hero h1 {
		margin: 0;
		font-family: var(--font-display);
		font-size: clamp(2rem, 4vw, 3rem);
		font-weight: 600;
		letter-spacing: -0.03em;
		line-height: 1.1;
	}

	.page-hero p {
		margin: 0.75rem 0 0;
		max-width: 40rem;
		color: color-mix(in srgb, var(--ink) 80%, var(--mesh-grey));
	}

	.eyebrow {
		margin: 0 0 0.5rem;
		font-family: var(--font-mono);
		font-size: 0.75rem;
		letter-spacing: 0.08em;
		text-transform: uppercase;
		color: var(--gold-text);
	}
</style>

---
import Layout from '../layouts/Layout.astro';
import Button from '../components/ds/Button.astro';
import { claimText } from '../lib/claims';
import { readSecret } from '../lib/env';

const phone = claimText('phone-310-904-2655') ?? 'Call (310) 904-2655.';
const sameDay = claimText('same-day-printing');
const losAngeles = claimText('los-angeles');
const turnstileSiteKey = (await readSecret('TURNSTILE_SITE_KEY')) ?? '';
---

<Layout
  title="Contact"
  description="Contact LiAlvaro T-Shirt Printing in Los Angeles for quotes, design help, and custom apparel projects."
>
  <div class="page-shell">
    <header class="page-hero">
      <p class="eyebrow">Contact</p>
      <h1>Let’s talk project.</h1>
      <p>Got an idea? Need a quote? Call or send a message — we’re happy to help.</p>
    </header>

    <div class="contact-grid">
      <article class="card">
        <h2>Call us</h2>
        <p>The fastest way to get clarity on timing and pricing.</p>
        <Button href="tel:3109042655">{phone}</Button>
      </article>
      <article class="card">
        <h2>Los Angeles</h2>
        <p>{losAngeles ?? 'Serving customers from Los Angeles, California.'}</p>
        {sameDay ? <p class="note">{sameDay}</p> : null}
        <button type="button" class="linkish" data-quote-trigger>Get a free quote →</button>
      </article>
    </div>

    <section class="contact-form-band" aria-labelledby="contact-form-title">
      <h2 id="contact-form-title">Send a message</h2>
      <p>Tell us what you need — we’ll follow up by phone or email.</p>
      <form id="contactForm" class="contact-form">
        <input type="text" name="_gotcha" value="" tabindex="-1" autocomplete="off" class="hp" aria-hidden="true" />
        <label>
          Name*
          <input type="text" name="name" required autocomplete="name" />
        </label>
        <div class="contact-form__row">
          <label>
            Email*
            <input type="email" name="email" required autocomplete="email" />
          </label>
          <label>
            Phone
            <input type="tel" name="phone" autocomplete="tel" />
          </label>
        </div>
        <label>
          Message*
          <textarea name="message" rows="5" required placeholder="Quantity, garment, timing, or questions"></textarea>
        </label>
        {turnstileSiteKey ? <div class="cf-turnstile" data-sitekey={turnstileSiteKey}></div> : null}
        <button type="submit" class="ds-btn ds-btn--primary">Send message</button>
        {turnstileSiteKey ? <script src="https://challenges.cloudflare.com/turnstile/v0/api.js" async defer></script> : null}
        <p id="contactMsg" class="contact-form__msg" hidden></p>
      </form>
    </section>
  </div>
</Layout>

<script>
  const form = document.getElementById('contactForm');
  form?.addEventListener('submit', async (event) => {
    event.preventDefault();
    if (!(form instanceof HTMLFormElement)) return;
    const msg = document.getElementById('contactMsg');
    const submit = form.querySelector('button[type="submit"]');
    if (submit instanceof HTMLButtonElement) submit.disabled = true;
    try {
      const res = await fetch('/api/contact', {
        method: 'POST',
        body: new FormData(form),
        headers: { Accept: 'application/json' },
      });
      const body = (await res.json()) as { error?: string; ok?: boolean };
      if (!msg) return;
      msg.hidden = false;
      msg.classList.toggle('is-error', !res.ok);
      if (!res.ok) {
        msg.textContent = body.error ?? 'Could not send your message.';
        return;
      }
      msg.textContent = 'Message sent. We’ll get back to you soon.';
      form.reset();
    } finally {
      if (submit instanceof HTMLButtonElement) submit.disabled = false;
    }
  });
</script>

<style>
  .contact-grid {
    display: grid;
    gap: 1rem;
  }

  @media (min-width: 800px) {
    .contact-grid {
      grid-template-columns: repeat(2, 1fr);
    }
  }

  .card {
    background: var(--white);
    border: 1px solid var(--color-border-strong);
    border-radius: var(--radius-lg);
    padding: 1.5rem;
    display: grid;
    gap: 0.75rem;
    align-content: start;
  }

  .card h2 {
    margin: 0;
    font-size: var(--text-xl);
  }

  .card p {
    margin: 0;
    color: color-mix(in srgb, var(--ink) 80%, var(--mesh-grey));
  }

  .note {
    font-size: var(--text-sm);
  }

  .contact-form-band {
    margin-top: 2.5rem;
    padding: 1.75rem;
    background: var(--white);
    border: 1px solid var(--color-border-strong);
    border-radius: var(--radius-lg);
  }

  .contact-form-band h2 {
    margin: 0;
    font-family: var(--font-display);
    text-transform: uppercase;
    font-weight: 600;
    text-align: center;
  }

  .contact-form-band > p {
    margin: 0.5rem 0 1.25rem;
    text-align: center;
  }

  .contact-form {
    display: grid;
    gap: 0.9rem;
    max-width: 36rem;
    margin-inline: auto;
  }

  .contact-form__row {
    display: grid;
    gap: 0.9rem;
  }

  @media (min-width: 640px) {
    .contact-form__row {
      grid-template-columns: 1fr 1fr;
    }
  }

  .contact-form label {
    display: grid;
    gap: 0.35rem;
    font-size: var(--text-sm);
    font-weight: 600;
  }

  .contact-form input,
  .contact-form textarea {
    width: 100%;
    box-sizing: border-box;
    min-height: 44px;
    padding: 0.65rem 0.75rem;
    border: 1px solid var(--color-border-strong);
    border-radius: var(--radius-md);
    font: inherit;
    font-weight: 400;
  }

  .contact-form textarea {
    min-height: 8rem;
    resize: vertical;
  }

  .hp {
    position: absolute;
    left: -9999px;
    width: 1px;
    height: 1px;
    overflow: hidden;
  }

  .ds-btn--primary {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    min-height: 44px;
    padding: 0.7rem 1.15rem;
    border: 0;
    border-radius: var(--radius-pill);
    background: var(--print-red);
    color: var(--white);
    font-family: var(--font-body);
    font-size: var(--text-sm);
    font-weight: 700;
    cursor: pointer;
    justify-self: center;
  }

  .ds-btn--primary:disabled {
    opacity: 0.65;
    cursor: wait;
  }

  .contact-form__msg {
    margin: 0;
    text-align: center;
    font-weight: 600;
    color: var(--studio-green);
  }

  .contact-form__msg.is-error {
    color: #c8102e;
  }

  .linkish {
    background: none;
    border: none;
    color: var(--print-red);
    font: inherit;
    font-weight: 700;
    text-decoration: underline;
    cursor: pointer;
    min-height: 44px;
    justify-self: start;
    padding: 0;
  }
</style>

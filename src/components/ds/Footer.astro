---
interface Props {
  class?: string;
}

const { class: className = '' } = Astro.props;
const year = new Date().getFullYear();
---

<footer class:list={['ds-footer', className]}>
  <div class="ds-footer__inner">
    <div class="ds-footer__brand">
      <p class="ds-footer__name">LiAlvaro T-Shirt Printing</p>
      <p class="ds-footer__tagline">Custom apparel printing in Los Angeles — design online or request a quote.</p>
      <p class="ds-footer__contact">
        <a href="tel:3109042655">(310) 904-2655</a>
        ·
        <a href="/contact/">Contact form</a>
      </p>
    </div>

    <div>
      <p class="ds-footer__heading">Shop</p>
      <ul>
        <li><a href="/shop/">Shop</a></li>
        <li><a href="/design/">Design Studio</a></li>
      </ul>
    </div>

    <div>
      <p class="ds-footer__heading">Services</p>
      <ul>
        <li><a href="/services/screen-printing/">Screen Printing</a></li>
        <li><a href="/services/direct-to-garment/">Direct To Garment</a></li>
        <li><a href="/services/dtf-heat-transfers/">DTF and Heat Transfers</a></li>
        <li><a href="/services/embroidery/">Embroidery</a></li>
      </ul>
    </div>

    <div>
      <p class="ds-footer__heading">Company</p>
      <ul>
        <li><a href="/about/">About</a></li>
        <li><a href="/faq/">FAQs</a></li>
        <li><a href="/articles/">Articles</a></li>
        <li><a href="/contact/">Contact</a></li>
        <li><a href="/privacy/">Privacy Policy</a></li>
        <li><a href="/terms/">Terms of Service</a></li>
      </ul>
    </div>
  </div>
  <p class="ds-footer__legal">© {year} LiAlvaro T-Shirt Printing. All rights reserved. Los Angeles, CA.</p>
</footer>

<style>
  .ds-footer {
    background: var(--canvas);
    color: var(--ink);
    padding: var(--space-8) 0 var(--space-6);
  }

  .ds-footer__inner,
  .ds-footer__legal {
    box-sizing: border-box;
    width: min(var(--site-max), calc(100% - 2 * var(--site-gutter)));
    max-width: none;
    margin-inline: auto;
    padding-inline: var(--site-pad);
  }

  .ds-footer__inner {
    display: grid;
    gap: var(--space-5);
  }

  @media (min-width: 800px) {
    .ds-footer__inner {
      grid-template-columns: 1.5fr repeat(3, 1fr);
    }
  }

  .ds-footer__name {
    margin: 0 0 var(--space-2);
    font-family: var(--font-display);
    font-size: var(--text-xl);
    font-weight: 600;
    letter-spacing: -0.02em;
  }

  .ds-footer__tagline,
  .ds-footer__contact {
    margin: 0;
    font-size: var(--text-sm);
    color: var(--mesh-text);
    line-height: var(--leading-normal);
  }

  .ds-footer__contact {
    margin-top: var(--space-3);
  }

  .ds-footer__heading {
    margin: 0 0 var(--space-2);
    font-family: var(--font-body);
    font-size: var(--text-sm);
    font-weight: 600;
    color: var(--ink);
  }

  .ds-footer ul {
    list-style: none;
    margin: 0;
    padding: 0;
    display: grid;
    gap: 0.35rem;
  }

  .ds-footer a,
  .ds-footer button {
    color: inherit;
    text-decoration: none;
    background: none;
    border: none;
    padding: 0;
    font: inherit;
    cursor: pointer;
    text-align: left;
  }

  .ds-footer a:hover,
  .ds-footer button:hover {
    color: var(--print-red);
  }

  .ds-footer a:focus-visible,
  .ds-footer button:focus-visible {
    outline: 3px solid var(--color-focus);
    outline-offset: 2px;
  }

  .ds-footer__legal {
    margin-top: var(--space-6);
    padding-top: var(--space-4);
    border-top: 1px solid var(--color-border-strong);
    font-size: var(--text-xs);
    color: var(--mesh-text);
  }
</style>

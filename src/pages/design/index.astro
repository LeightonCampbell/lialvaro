---
import Layout from '../../layouts/Layout.astro';
import { claimText } from '../../lib/claims';
import { getStudioConfig, studioUnitPriceCents } from '../../lib/design-studio';

const phone = claimText('phone-310-904-2655') ?? 'Call (310) 904-2655.';
const studio = getStudioConfig();
const priceMap = Object.fromEntries(studio.products.map((p) => [p.id, studioUnitPriceCents(p.id)]));
---

<Layout
  title="Design Studio"
  description="Design Studio at LiAlvaro T-Shirt Printing. Design on a blank, export print-ready art, and checkout."
>
  <div
    class="studio-app"
    id="designStudioRoot"
    data-studio
    data-price-map={JSON.stringify(priceMap)}
  >
    <div class="studio-toolbar" role="toolbar" aria-label="Design tools">
      <a class="tb-item" href="/" title="Back to site">
        <span class="tb-ico" aria-hidden="true">←</span>
        <span>Back</span>
      </a>
      <button type="button" class="tb-item" id="btnAddText" title="Add text">
        <span class="tb-ico" aria-hidden="true">T</span>
        <span>Add text</span>
      </button>
      <button type="button" class="tb-item" id="btnUpload" title="Add design">
        <span class="tb-ico" aria-hidden="true">▢+</span>
        <span>Add design</span>
      </button>
      <button type="button" class="tb-item" id="btnQtySize" title="Quantity & size" aria-expanded="false" aria-controls="qtyPanel">
        <span class="tb-ico" aria-hidden="true">▣</span>
        <span>Quantity &amp; size</span>
      </button>
      <button type="button" class="tb-item" id="btnSaveShare" title="Save design">
        <span class="tb-ico" aria-hidden="true">⇅</span>
        <span>Save | Share</span>
      </button>
      <a class="tb-item" href="/cart/" title="Cart">
        <span class="tb-ico" aria-hidden="true">◉</span>
        <span>My cart</span>
        <span class="cart-badge" id="studioCartBadge" hidden>0</span>
      </a>
      <button type="button" class="tb-pricing" id="btnSeePricing">
        See Pricing
        <span aria-hidden="true">→</span>
      </button>
      <input id="fileInput" type="file" accept="image/png,image/jpeg,image/svg+xml,.png,.jpg,.jpeg,.svg" hidden />
    </div>

    <div class="studio-body">
      <aside class="studio-left" aria-label="Product">
        <h2>Product</h2>
        <div class="product-card">
          <div class="product-thumb" id="productThumb" aria-hidden="true"></div>
          <p class="product-name" id="productName">Classic Tee</p>
          <p class="product-blurb" id="productBlurb">Soft everyday tee — front and back print areas.</p>
          <button type="button" class="btn-outline" id="btnChangeProduct">Change Product</button>
          <button type="button" class="text-link" id="btnProductDesc">Product description</button>
        </div>

        <div class="color-block">
          <p class="color-label">Selected Color: <strong id="selectedColorLabel">Black</strong></p>
          <div id="colorButtons" class="swatches"></div>
        </div>

        <div class="help-box">
          <strong>Need help?</strong>
          <p>
            <a href="/contact/">Contact us</a> or call {phone.replace(/^Call\s+/i, '')}
          </p>
          <button type="button" class="text-link" data-quote-trigger>Need a custom quote instead?</button>
        </div>
      </aside>

      <section class="studio-center" aria-label="Design canvas">
        <div class="stage-tools">
          <button type="button" class="icon-btn" id="btnZoomOut" title="Zoom out">−</button>
          <button type="button" class="icon-btn" id="btnZoomIn" title="Zoom in">+</button>
          <button type="button" class="icon-btn" id="btnToggleGrid" title="Toggle grid" aria-pressed="false">Grid</button>
          <button type="button" class="icon-btn" id="btnForward" title="Bring forward">Layers ↑</button>
          <button type="button" class="icon-btn" id="btnBack" title="Send backward">Layers ↓</button>
          <button type="button" class="icon-btn" id="btnUndo" title="Undo">Undo</button>
          <button type="button" class="icon-btn" id="btnRedo" title="Redo">Redo</button>
          <button type="button" class="icon-btn" id="btnDelete" title="Delete selected">Delete</button>
          <label class="text-color-mini" title="Text / fill color">
            <input id="textColor" type="color" value="#c8102e" />
          </label>
        </div>

        <div class="method-toggle" role="group" aria-label="Decoration method">
          <button type="button" class="method is-active" id="methodPrint" aria-pressed="true">Printing</button>
          <button type="button" class="method is-disabled" id="methodEmbroidery" aria-pressed="false" disabled title="Embroidery coming later">Embroidery</button>
        </div>

        <div class="studio-stage" id="studioStage">
          <div class="studio-mockup" id="studioMockup" data-shape="tee" aria-hidden="true">
            <svg class="garment-svg" viewBox="0 0 200 240" preserveAspectRatio="xMidYMid meet">
              <path
                id="garmentPath"
                d="M40 42 L70 28 L85 48 L115 48 L130 28 L160 42 L175 70 L155 82 L148 70 L148 210 L52 210 L52 70 L45 82 L25 70 Z"
                fill="currentColor"
              />
            </svg>
          </div>
          <div class="print-frame" id="printFrame">
            <canvas id="studioCanvas" width="360" height="480"></canvas>
            <div class="empty-ctas" id="emptyCtas">
              <button type="button" class="empty-cta" data-action="upload">
                <span aria-hidden="true">↑</span> Upload image
              </button>
              <button type="button" class="empty-cta" data-action="text">
                <span aria-hidden="true">T</span> Add text
              </button>
              <button type="button" class="empty-cta" data-action="note" id="btnDesignNote">
                <span aria-hidden="true">✎</span> Add design note
              </button>
            </div>
          </div>
        </div>

        <p class="studio-status" id="studioStatus" role="status"></p>
        <ul class="studio-warnings" id="studioWarnings" hidden></ul>
      </section>

      <aside class="studio-right" aria-label="Print areas">
        <div class="right-utils">
          <a class="util" href="/contact/">Need help?</a>
          <a class="util" href="/faq/">Delivery Info</a>
          <button type="button" class="util" id="btnPreview">Preview</button>
        </div>
        <h2>Print area</h2>
        <div id="sideButtons" class="print-thumbs"></div>
        <p class="sleeve-note">Left / right sleeve placements are not available yet on this blank.</p>
      </aside>
    </div>

    <!-- Change product drawer -->
    <div class="drawer" id="productDrawer" hidden>
      <div class="drawer__backdrop" data-close-drawer></div>
      <div class="drawer__panel" role="dialog" aria-labelledby="productDrawerTitle">
        <header>
          <h2 id="productDrawerTitle">Change Product</h2>
          <button type="button" class="icon-btn" data-close-drawer aria-label="Close">×</button>
        </header>
        <div id="productButtons" class="product-buttons"></div>
      </div>
    </div>

    <!-- Qty / size panel -->
    <div class="drawer drawer--right" id="qtyPanel" hidden>
      <div class="drawer__backdrop" data-close-qty></div>
      <div class="drawer__panel" role="dialog" aria-labelledby="qtyTitle">
        <header>
          <h2 id="qtyTitle">Quantity &amp; size</h2>
          <button type="button" class="icon-btn" data-close-qty aria-label="Close">×</button>
        </header>
        <label class="field">
          Size
          <select id="studioSize">
            <option>S</option>
            <option selected>M</option>
            <option>L</option>
            <option>XL</option>
            <option>2XL</option>
          </select>
        </label>
        <label class="field">
          Quantity
          <input id="studioQty" type="number" min="1" max="20" value="1" />
        </label>
        <button type="button" class="btn-outline" data-close-qty>Done</button>
      </div>
    </div>

    <!-- Pricing / checkout rail -->
    <div class="drawer drawer--right" id="pricingPanel" hidden>
      <div class="drawer__backdrop" data-close-pricing></div>
      <div class="drawer__panel" role="dialog" aria-labelledby="pricingTitle">
        <header>
          <h2 id="pricingTitle">See Pricing</h2>
          <button type="button" class="icon-btn" data-close-pricing aria-label="Close">×</button>
        </header>
        <p class="price" id="studioPrice" data-cents={priceMap.studio_tee ?? 0}>—</p>
        <p class="fine">Unit price from catalog blank. Final total calculated at checkout.</p>
        <label class="attest">
          <input id="ipAttest" type="checkbox" />
          <span>
            I confirm I own or have rights to this artwork, and I accept the
            <a href="/terms/">Terms</a>.
          </span>
        </label>
        <button type="button" class="btn-pricing-solid" id="btnExport">Export &amp; add to cart</button>
        <p class="fine">Downloads a print-ready PNG and saves your design. Report misuse via <a href="/contact/">Contact</a>.</p>
      </div>
    </div>

    <dialog id="descDialog" class="desc-dialog">
      <form method="dialog">
        <h2>Product description</h2>
        <p id="descBody"></p>
        <button type="submit" class="btn-outline">Close</button>
      </form>
    </dialog>
  </div>
</Layout>

<script>
  import { initDesignStudio } from '../../scripts/design-studio-app.ts';
  initDesignStudio();
</script>

<style is:global>
  /* Full-bleed studio under site chrome */
  main:has(.studio-app) {
    padding: 0;
    max-width: none;
  }

  main:has(.studio-app) > .studio-app {
    max-width: none;
    margin: 0;
    padding: 0;
  }

  .studio-app {
    --studio-navy: #1b2233;
    --studio-stage: #eceef2;
    --studio-blue: #2563eb;
    display: flex;
    flex-direction: column;
    min-height: calc(100vh - 120px);
    background: var(--white);
    font-family: var(--font-body);
  }

  .studio-toolbar {
    display: flex;
    flex-wrap: wrap;
    align-items: stretch;
    gap: 0;
    background: var(--studio-navy);
    color: var(--white);
    border-bottom: 1px solid color-mix(in srgb, var(--white) 12%, transparent);
  }

  .tb-item {
    display: flex;
    flex-direction: column;
    align-items: center;
    justify-content: center;
    gap: 0.2rem;
    min-width: 4.5rem;
    padding: 0.55rem 0.75rem;
    color: var(--white);
    text-decoration: none;
    background: transparent;
    border: none;
    border-right: 1px solid color-mix(in srgb, var(--white) 12%, transparent);
    font: inherit;
    font-size: 0.7rem;
    font-weight: 600;
    cursor: pointer;
    position: relative;
  }

  .tb-item:hover,
  .tb-item:focus-visible {
    background: color-mix(in srgb, var(--white) 10%, transparent);
  }

  .tb-ico {
    font-size: 1.05rem;
    line-height: 1;
    font-family: var(--font-display);
  }

  .cart-badge {
    position: absolute;
    top: 0.35rem;
    right: 0.45rem;
    min-width: 1.1rem;
    height: 1.1rem;
    padding: 0 0.25rem;
    border-radius: 999px;
    background: var(--print-red);
    color: var(--white);
    font-size: 0.65rem;
    line-height: 1.1rem;
    text-align: center;
  }

  .tb-pricing {
    margin-left: auto;
    display: inline-flex;
    align-items: center;
    gap: 0.5rem;
    padding: 0 1.25rem;
    background: var(--studio-blue);
    color: var(--white);
    border: none;
    font-family: var(--font-display);
    font-weight: 700;
    font-size: 0.95rem;
    cursor: pointer;
    min-height: 3.25rem;
  }

  .tb-pricing:hover {
    filter: brightness(1.05);
  }

  .studio-body {
    display: grid;
    grid-template-columns: 1fr;
    flex: 1;
    min-height: 0;
  }

  @media (min-width: 1024px) {
    .studio-body {
      grid-template-columns: 260px minmax(0, 1fr) 150px;
    }
  }

  .studio-left,
  .studio-right {
    background: var(--white);
    border-bottom: 1px solid var(--color-border);
    padding: 1rem;
  }

  @media (min-width: 1024px) {
    .studio-left {
      border-bottom: none;
      border-right: 1px solid var(--color-border);
    }
    .studio-right {
      border-bottom: none;
      border-left: 1px solid var(--color-border);
    }
  }

  .studio-left h2,
  .studio-right h2 {
    margin: 0 0 0.75rem;
    font-family: var(--font-display);
    font-size: 1.05rem;
    font-weight: 700;
  }

  .product-card {
    display: grid;
    gap: 0.5rem;
  }

  .product-thumb {
    width: 72px;
    height: 72px;
    border-radius: 6px;
    border: 1px solid var(--color-border);
    background: var(--ink);
  }

  .product-name {
    margin: 0;
    font-weight: 700;
    font-size: 0.95rem;
  }

  .product-blurb {
    margin: 0;
    font-size: 0.8rem;
    color: var(--color-muted);
  }

  .btn-outline,
  .btn-pricing-solid {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    min-height: 2.5rem;
    padding: 0.5rem 0.85rem;
    border-radius: 4px;
    font: inherit;
    font-weight: 700;
    cursor: pointer;
  }

  .btn-outline {
    background: var(--white);
    border: 1px solid var(--studio-navy);
    color: var(--studio-navy);
  }

  .btn-pricing-solid {
    width: 100%;
    background: var(--studio-blue);
    border: none;
    color: var(--white);
  }

  .text-link {
    background: none;
    border: none;
    padding: 0;
    color: var(--studio-blue);
    font: inherit;
    font-size: 0.85rem;
    font-weight: 600;
    text-align: left;
    cursor: pointer;
    text-decoration: underline;
  }

  .color-block {
    margin-top: 1.25rem;
  }

  .color-label {
    margin: 0 0 0.5rem;
    font-size: 0.85rem;
  }

  .swatches {
    display: grid;
    grid-template-columns: repeat(8, 1fr);
    gap: 0.4rem;
  }

  .swatch {
    width: 100%;
    aspect-ratio: 1;
    border-radius: 999px;
    border: 1px solid color-mix(in srgb, var(--ink) 35%, transparent);
    cursor: pointer;
    padding: 0;
  }

  .swatch.is-active {
    outline: 2px solid var(--studio-blue);
    outline-offset: 2px;
  }

  .help-box {
    margin-top: 1.5rem;
    padding: 0.85rem;
    background: color-mix(in srgb, var(--studio-blue) 8%, var(--white));
    border-radius: 6px;
    font-size: 0.85rem;
  }

  .help-box p {
    margin: 0.35rem 0 0.5rem;
  }

  .studio-center {
    display: flex;
    flex-direction: column;
    gap: 0.65rem;
    padding: 0.75rem 1rem 1.25rem;
    background: var(--studio-stage);
    min-height: 520px;
  }

  .stage-tools {
    display: flex;
    flex-wrap: wrap;
    gap: 0.35rem;
    align-items: center;
  }

  .icon-btn {
    min-height: 2rem;
    padding: 0.25rem 0.55rem;
    border: 1px solid var(--color-border-strong);
    border-radius: 4px;
    background: var(--white);
    font: inherit;
    font-size: 0.75rem;
    font-weight: 600;
    cursor: pointer;
  }

  .icon-btn[aria-pressed='true'] {
    border-color: var(--studio-blue);
    color: var(--studio-blue);
  }

  .text-color-mini input {
    width: 2rem;
    height: 2rem;
    padding: 0;
    border: 1px solid var(--color-border);
    background: transparent;
    cursor: pointer;
  }

  .method-toggle {
    display: inline-flex;
    align-self: center;
    border: 1px solid var(--color-border-strong);
    border-radius: 999px;
    overflow: hidden;
    background: var(--white);
  }

  .method {
    border: none;
    background: transparent;
    padding: 0.4rem 1rem;
    font: inherit;
    font-size: 0.8rem;
    font-weight: 700;
    cursor: pointer;
  }

  .method.is-active {
    background: var(--studio-blue);
    color: var(--white);
  }

  .method.is-disabled {
    opacity: 0.45;
    cursor: not-allowed;
  }

  .studio-stage {
    position: relative;
    flex: 1;
    min-height: 440px;
    margin: 0 auto;
    width: min(100%, 520px);
    transform-origin: center top;
    transition: transform var(--duration-med) var(--ease-out);
  }

  .studio-stage.is-grid::before {
    content: '';
    position: absolute;
    inset: 0;
    z-index: 1;
    pointer-events: none;
    background-image:
      linear-gradient(to right, color-mix(in srgb, var(--ink) 12%, transparent) 1px, transparent 1px),
      linear-gradient(to bottom, color-mix(in srgb, var(--ink) 12%, transparent) 1px, transparent 1px);
    background-size: 24px 24px;
    opacity: 0.5;
  }

  .studio-mockup {
    position: absolute;
    inset: 0;
    color: #1b2233;
    display: grid;
    place-items: center;
  }

  .garment-svg {
    width: 88%;
    height: 92%;
    filter: drop-shadow(0 8px 18px color-mix(in srgb, var(--ink) 18%, transparent));
  }

  .print-frame {
    position: absolute;
    z-index: 2;
    border: 1px dashed color-mix(in srgb, var(--studio-blue) 70%, var(--white));
    background: color-mix(in srgb, var(--white) 8%, transparent);
    touch-action: none;
  }

  .print-frame canvas {
    display: block;
    width: 100% !important;
    height: 100% !important;
  }

  .empty-ctas {
    position: absolute;
    inset: 0;
    z-index: 3;
    display: grid;
    place-content: center;
    gap: 0.5rem;
    padding: 0.75rem;
    pointer-events: none;
  }

  .empty-ctas[hidden] {
    display: none;
  }

  .empty-cta {
    pointer-events: auto;
    display: inline-flex;
    align-items: center;
    justify-content: center;
    gap: 0.45rem;
    min-width: 10rem;
    min-height: 2.4rem;
    padding: 0.45rem 0.85rem;
    border: 1px solid var(--color-border-strong);
    border-radius: 4px;
    background: var(--white);
    font: inherit;
    font-size: 0.85rem;
    font-weight: 700;
    cursor: pointer;
    box-shadow: 0 2px 8px color-mix(in srgb, var(--ink) 12%, transparent);
  }

  .studio-status {
    margin: 0;
    text-align: center;
    font-size: 0.85rem;
    font-weight: 600;
  }

  .studio-warnings {
    margin: 0 auto;
    max-width: 36rem;
    padding-left: 1.1rem;
    color: var(--color-danger);
    font-size: 0.85rem;
  }

  .right-utils {
    display: grid;
    gap: 0.35rem;
    margin-bottom: 1rem;
  }

  .util {
    background: none;
    border: none;
    padding: 0;
    color: var(--studio-navy);
    font: inherit;
    font-size: 0.75rem;
    font-weight: 600;
    text-align: left;
    text-decoration: none;
    cursor: pointer;
  }

  .print-thumbs {
    display: grid;
    gap: 0.65rem;
  }

  .print-thumb {
    display: grid;
    gap: 0.25rem;
    padding: 0;
    border: 2px solid transparent;
    background: transparent;
    cursor: pointer;
    font: inherit;
    text-align: center;
  }

  .print-thumb.is-active {
    border-color: var(--studio-blue);
  }

  .print-thumb.is-disabled {
    opacity: 0.4;
    cursor: not-allowed;
  }

  .print-thumb__preview {
    width: 100%;
    aspect-ratio: 3 / 4;
    border: 1px solid var(--color-border);
    border-radius: 4px;
    background: #dfe3ea;
    position: relative;
    overflow: hidden;
  }

  .print-thumb__preview span {
    position: absolute;
    left: 28%;
    top: 22%;
    width: 44%;
    height: 48%;
    border: 2px solid #f5c518;
    box-sizing: border-box;
  }

  .print-thumb__label {
    font-size: 0.75rem;
    font-weight: 700;
  }

  .sleeve-note {
    margin: 0.75rem 0 0;
    font-size: 0.7rem;
    color: var(--color-muted);
  }

  .drawer[hidden] {
    display: none;
  }

  .drawer {
    position: fixed;
    inset: 0;
    z-index: 80;
  }

  .drawer__backdrop {
    position: absolute;
    inset: 0;
    background: color-mix(in srgb, var(--ink) 45%, transparent);
  }

  .drawer__panel {
    position: absolute;
    top: 0;
    bottom: 0;
    left: 0;
    width: min(100%, 360px);
    background: var(--white);
    padding: 1rem;
    display: grid;
    gap: 0.75rem;
    align-content: start;
    box-shadow: 8px 0 24px color-mix(in srgb, var(--ink) 20%, transparent);
  }

  .drawer--right .drawer__panel {
    left: auto;
    right: 0;
    box-shadow: -8px 0 24px color-mix(in srgb, var(--ink) 20%, transparent);
  }

  .drawer__panel header {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 0.5rem;
  }

  .drawer__panel h2 {
    margin: 0;
    font-family: var(--font-display);
    font-size: 1.1rem;
  }

  .product-buttons {
    display: grid;
    gap: 0.5rem;
  }

  .product-chip {
    display: grid;
    gap: 0.15rem;
    text-align: left;
    border: 2px solid var(--ink);
    border-radius: 6px;
    background: var(--white);
    padding: 0.75rem;
    font: inherit;
    cursor: pointer;
  }

  .product-chip.is-active {
    border-color: var(--studio-blue);
  }

  .product-chip strong {
    font-weight: 700;
  }

  .product-chip span {
    font-size: 0.85rem;
    color: var(--color-muted);
  }

  .field {
    display: grid;
    gap: 0.35rem;
    font-size: 0.85rem;
    font-weight: 600;
  }

  .field select,
  .field input {
    min-height: 2.5rem;
    padding: 0.4rem 0.55rem;
    border: 1px solid var(--color-border-strong);
    border-radius: 4px;
    font: inherit;
  }

  .price {
    margin: 0;
    font-family: var(--font-mono);
    font-size: 1.5rem;
    font-weight: 700;
  }

  .fine {
    margin: 0;
    font-size: 0.8rem;
    color: var(--color-muted);
  }

  .attest {
    display: grid;
    grid-template-columns: auto 1fr;
    gap: 0.55rem;
    font-size: 0.85rem;
  }

  .desc-dialog {
    border: 1px solid var(--color-border-strong);
    border-radius: 8px;
    padding: 1.25rem;
    max-width: 28rem;
  }

  .desc-dialog::backdrop {

{
	"compatibility_date": "2026-03-17",
	"compatibility_flags": [
		"global_fetch_strictly_public"
	],
	"name": "lialvaro-redesign",
	"main": "@astrojs/cloudflare/entrypoints/server",
	"assets": {
		"directory": "./dist",
		"binding": "ASSETS"
	},
	"observability": {
		"enabled": true
	},
	"d1_databases": [
		{
			"binding": "DB",
			"database_name": "lialvaro-commerce",
			"database_id": "26c850ff-29cb-434b-a9fa-08b3fe577b99",
			"migrations_dir": "migrations"
		}
	]
}

---
import Layout from '../../layouts/Layout.astro';
import Button from '../../components/ds/Button.astro';
---

<Layout
  title="Cart"
  description="Your LiAlvaro cart. Commerce checkout ships in a later stage."
  noindex={true}
>
  <div class="page-shell">
    <header class="page-hero">
      <p class="eyebrow">Cart</p>
      <h1>Your cart</h1>
      <p>Your cart is empty. Browse products to get started, or request a custom quote.</p>
    </header>
    <div class="actions">
      <Button href="/shop/">Browse products</Button>
      <button type="button" class="ds-btn ds-btn--secondary" data-quote-trigger>Get a custom quote</button>
    </div>
  </div>
</Layout>

<style>
  .actions {
    display: flex;
    flex-wrap: wrap;
    gap: 0.75rem;
  }

  .actions .ds-btn--secondary {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    min-height: 44px;
    padding: 0.7rem 1.15rem;
    border: 2px solid var(--ink);
    border-radius: var(--radius-md);
    background: var(--white);
    color: var(--ink);
    font-family: var(--font-body);
    font-size: var(--text-sm);
    font-weight: 700;
    cursor: pointer;
  }
</style>

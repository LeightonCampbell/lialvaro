---
import Layout from '../layouts/Layout.astro';

const articles = [
  {
    href: '/best-affordable-custom-t-shirt-printing-in-los-angeles-2026-local-guide/',
    imageUrl: '/images/screenprinting.jpg',
    meta: 'Local Guide · 5 Min Read',
    title: 'Best Affordable Custom T-Shirt Printing in Los Angeles (2026 Local Guide)',
    excerpt: 'How to navigate the LA market for high-quality prints without overspending.',
  },
  {
    href: '/the-ultimate-guide-to-finding-the-perfect-place-for-your-bulk-custom-t-shirt-event-needs/',
    imageUrl: '/images/DTF.jpg',
    meta: 'Event Planning · 8 Min Read',
    title: 'The Ultimate Guide to Finding the Perfect Place for Your Bulk Custom T-Shirt Event Needs',
    excerpt: 'What to look for when choosing a print partner for high-volume event orders.',
  },
];
---

<Layout
  title="Articles"
  description="Guides and insights on custom apparel printing from LiAlvaro T-Shirt Printing in Los Angeles."
>
  <div class="page-shell">
    <header class="page-hero">
      <p class="eyebrow">Articles</p>
      <h1>Guides &amp; insights.</h1>
      <p>Practical notes on custom apparel from Los Angeles.</p>
    </header>

    <div class="articles-grid">
      {
        articles.map((article) => (
          <a class="article-card" href={article.href}>
            <img src={article.imageUrl} alt="" width="640" height="400" loading="lazy" decoding="async" />
            <div class="article-card__body">
              <p class="meta">{article.meta}</p>
              <h2>{article.title}</h2>
              <p>{article.excerpt}</p>
            </div>
          </a>
        ))
      }
    </div>
  </div>
</Layout>

<style>
  .articles-grid {
    display: grid;
    gap: 1rem;
  }

  @media (min-width: 800px) {
    .articles-grid {
      grid-template-columns: 1fr 1fr;
    }
  }

  .article-card {
    display: grid;
    background: var(--white);
    border: 1px solid var(--color-border-strong);
    border-radius: var(--radius-lg);
    overflow: hidden;
    text-decoration: none;
    color: inherit;
  }

  .article-card img {
    width: 100%;
    height: 200px;
    object-fit: cover;
    display: block;
  }

  .article-card__body {
    padding: 1.25rem;
    display: grid;
    gap: 0.5rem;
  }

  .meta {
    margin: 0;
    font-family: var(--font-mono);
    font-size: var(--text-xs);
    letter-spacing: 0.04em;
    text-transform: uppercase;
    color: var(--gold-text);
  }

  .article-card h2 {
    margin: 0;
    font-size: var(--text-lg);
    line-height: var(--leading-snug);
  }

  .article-card p:last-child {
    margin: 0;
    color: color-mix(in srgb, var(--ink) 80%, var(--mesh-grey));
  }

  .article-card:hover h2 {
    color: var(--print-red);
  }
</style>

---
import Photo from './Photo.astro';
import PriceTag from './PriceTag.astro';
import Badge from './Badge.astro';
import Button from './Button.astro';

interface Props {
  title?: string;
  href?: string;
  price?: string;
  badge?: string;
  image?: string;
  hoverImage?: string;
  empty?: boolean;
  disabled?: boolean;
  centered?: boolean;
  class?: string;
}

const {
  title = 'Product name',
  href = '#',
  price = '$24.00',
  badge,
  image,
  hoverImage,
  empty = false,
  disabled = false,
  centered = false,
  class: className = '',
} = Astro.props;
---

<article class:list={['ds-product-card', empty ? 'is-empty' : '', centered ? 'is-centered' : '', className]}>
  {
    empty ? (
      <div class="ds-product-card__empty">
        <p>No products to show yet.</p>
        <button type="button" class="ds-btn ds-btn--secondary" data-quote-trigger>Get a custom quote</button>
      </div>
    ) : (
      <>
        <a
          class:list={['ds-product-card__media', hoverImage ? 'has-hover' : '']}
          href={href}
          tabindex="-1"
          aria-hidden="true"
        >
          {hoverImage ? (
            <span class="ds-product-card__swap">
              <img class="ds-product-card__img is-main" src={image} alt="" width="600" height="600" loading="lazy" decoding="async" />
              <img class="ds-product-card__img is-hover" src={hoverImage} alt="" width="600" height="600" loading="lazy" decoding="async" />
            </span>
          ) : (
            <Photo alt={title} src={image} aspect="1/1" />
          )}
        </a>
        <div class="ds-product-card__body">
          {!centered && badge ? <Badge tone="gold">{badge}</Badge> : null}
          <h3 class="ds-product-card__title">
            <a href={href}>{title}</a>
          </h3>
          <PriceTag amount={price} />
          {disabled ? (
            <Button variant="secondary" disabled>Unavailable</Button>
          ) : (
            <Button variant="ghost" href={href}>View product</Button>
          )}
        </div>
      </>
    )
  }
</article>

<style>
  .ds-product-card {
    position: relative;
    display: grid;
    gap: var(--space-3);
    padding: var(--space-3);
    background: var(--white);
    border: 0;
    border-radius: var(--radius-lg);
    box-shadow: var(--shadow-soft);
  }

  .ds-product-card__media {
    display: block;
    text-decoration: none;
    overflow: hidden;
    border-radius: var(--radius-lg);
  }

  .ds-product-card__swap {
    position: relative;
    display: block;
    aspect-ratio: 1 / 1;
    background: var(--canvas);
    overflow: hidden;
  }

  .ds-product-card__img {
    display: block;
    width: 100%;
    height: 100%;
    object-fit: cover;
  }

  .ds-product-card__img.is-hover {
    position: absolute;
    inset: 0;
    opacity: 0;
    transition: opacity 0.25s ease;
  }

  .ds-product-card__media.has-hover:hover .ds-product-card__img.is-hover,
  .ds-product-card__media.has-hover:focus-visible .ds-product-card__img.is-hover {
    opacity: 1;
  }

  @media (hover: none) {
    .ds-product-card__img.is-hover {
      display: none;
    }
  }

  .ds-product-card__body {
    display: grid;
    gap: var(--space-2);
    justify-items: start;
  }

  .ds-product-card.is-centered .ds-product-card__body {
    justify-items: center;
    text-align: center;
  }

  .ds-product-card__title {
    margin: 0;
    font-family: var(--font-body);
    font-size: var(--text-md);
    font-weight: 700;
    line-height: var(--leading-snug);
  }

  .ds-product-card__title a {
    color: inherit;
    text-decoration: none;
  }

  .ds-product-card__title a:hover {
    color: var(--print-red);
  }

  .ds-product-card__title a:focus-visible {
    outline: 3px solid var(--color-focus);
    outline-offset: 2px;
  }

  .ds-product-card__empty {
    display: grid;
    gap: var(--space-3);
    min-height: 180px;
    place-content: center;
    text-align: center;
    color: var(--mesh-text);
  }

  .ds-product-card__empty p {
    margin: 0;
  }

  .ds-product-card__empty .ds-btn {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    min-height: 44px;
    padding: 0.7rem 1.15rem;
    border: 0;
    border-radius: var(--radius-pill);
    background: var(--white);
    color: var(--ink);
    font-family: var(--font-body);
    font-size: var(--text-sm);
    font-weight: 700;
    cursor: pointer;
    justify-self: center;
  }
</style>

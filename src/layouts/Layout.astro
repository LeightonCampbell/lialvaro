---
import '../styles/global.css';
import '../styles/home.css';
import Header from '../components/Header.astro';
import EmailSubscribe from '../components/EmailSubscribe.astro';
import Footer from '../components/Footer.astro';
import QuoteModal from '../components/QuoteModal.astro';

interface Props {
	title: string;
	description?: string;
	/** When true, `title` is used as the full document title (no `| Lialvaro…` suffix). */
	exactTitle?: boolean;
	keywords?: string;
	/** FAQ page link for primary nav. */
	faqHref?: string;
	/** Homepage printshop theme: canvas background and hide email strip. */
	home?: boolean;
}

const {
	title,
	description = 'Premium custom t-shirt printing and embroidery in Los Angeles. No minimums, same-day printing available.',
	exactTitle = false,
	keywords,
	faqHref = '/faq',
	home = false,
} = Astro.props;

const documentTitle = exactTitle ? title : `${title} | Lialvaro Custom Apparel`;
const canonicalOrigin = 'https://www.lialvaro.com';
const normalizedPathname =
	Astro.url.pathname === '/'
		? '/'
		: Astro.url.pathname.endsWith('/')
			? Astro.url.pathname
			: `${Astro.url.pathname}/`;
const canonicalUrl = new URL(normalizedPathname, canonicalOrigin).toString();
---

<!doctype html>
<html lang="en">
	<head>
		<meta charset="UTF-8" />
		<meta name="description" content={description} />
		{keywords ? <meta name="keywords" content={keywords} /> : null}
		<meta name="viewport" content="width=device-width, initial-scale=1.0" />
		<link rel="icon" type="image/x-icon" href="/images/favicon.ico" />
		<meta name="generator" content={Astro.generator} />
		<title>{documentTitle}</title>
		<link rel="canonical" href={canonicalUrl} />
		<link rel="preconnect" href="https://fonts.googleapis.com" />
		<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
		<link
			href="https://fonts.googleapis.com/css2?family=Anton&family=Inter:wght@400;500;600;700&family=IBM+Plex+Mono:wght@500;600&family=Manrope:wght@400;500;600;700;800&display=swap"
			rel="stylesheet"
		/>
		<slot name="head" />
	</head>
	<body class:list={[{ 'theme-home': home }]}>
		<Header faqHref={faqHref} />
		<main class="pt-nav">
			<slot />
		</main>
		{home ? null : <EmailSubscribe />}
		<Footer />
		<QuoteModal />
		<script>
			import '../scripts/cart.js';
		</script>
	</body>
</html>

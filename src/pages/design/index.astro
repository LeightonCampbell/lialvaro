---
import Layout from '../../layouts/Layout.astro';
import { claimText } from '../../lib/claims';
import { getStudioConfig, studioUnitPriceCents } from '../../lib/design-studio';

const phone = claimText('phone-310-904-2655') ?? 'Call (310) 904-2655.';
const studio = getStudioConfig();
const priceMap = Object.fromEntries(studio.products.map((p) => [p.id, studioUnitPriceCents(p.id)]));
---

<Layout
  title="Design Studio"
  description="Design Studio at LiAlvaro T-Shirt Printing. Design on a blank, export print-ready art, and checkout."
>
  <div
    class="studio-app"
    id="designStudioRoot"
    data-studio
    data-price-map={JSON.stringify(priceMap)}
  >
    <div class="studio-toolbar" role="toolbar" aria-label="Design tools">
      <a class="tb-item" href="/" title="Back to site">
        <span class="tb-ico" aria-hidden="true">←</span>
        <span>Back</span>
      </a>
      <button type="button" class="tb-item" id="btnAddText" title="Add text">
        <span class="tb-ico" aria-hidden="true">T</span>
        <span>Add text</span>
      </button>
      <button type="button" class="tb-item" id="btnUpload" title="Add design">
        <span class="tb-ico" aria-hidden="true">▢+</span>
        <span>Add design</span>
      </button>
      <button type="button" class="tb-item" id="btnQtySize" title="Quantity & size" aria-expanded="false" aria-controls="pricingPanel">
        <span class="tb-ico" aria-hidden="true">▣</span>
        <span>Quantity &amp; size</span>
      </button>
      <button type="button" class="tb-item" id="btnSaveShare" title="Save design">
        <span class="tb-ico" aria-hidden="true">⇅</span>
        <span>Save | Share</span>
      </button>
      <a class="tb-item" href="/cart/" title="Cart">
        <span class="tb-ico" aria-hidden="true">◉</span>
        <span>My cart</span>
        <span class="cart-badge" id="studioCartBadge" hidden>0</span>
      </a>
      <button type="button" class="tb-pricing" id="btnSeePricing" disabled title="Add a design to see pricing">
        See Pricing
        <span aria-hidden="true">→</span>
      </button>
      <input id="fileInput" type="file" accept="image/png,image/jpeg,image/svg+xml,.png,.jpg,.jpeg,.svg" aria-label="Upload artwork" hidden />
    </div>

    <div class="studio-body">
      <aside class="studio-left" aria-label="Product">
        <h2>Product</h2>
        <div class="product-card">
          <div class="product-thumb" id="productThumb" aria-hidden="true"></div>
          <p class="product-name" id="productName">Classic Tee</p>
          <p class="product-blurb" id="productBlurb">Soft everyday tee — front and back print areas.</p>
          <button type="button" class="btn-outline" id="btnChangeProduct">Change Product</button>
          <button type="button" class="text-link" id="btnProductDesc">Product description</button>
        </div>

        <div class="color-block">
          <p class="color-label">Selected Color: <strong id="selectedColorLabel">Black</strong></p>
          <div id="colorButtons" class="swatches"></div>
          <p class="preview-note" id="previewNote" hidden></p>
        </div>

        <div class="help-box">
          <strong>Need help?</strong>
          <p>
            <a href="/contact/">Contact us</a> or call {phone.replace(/^Call\s+/i, '')}
          </p>
          <button type="button" class="text-link" data-quote-trigger>Need a custom quote instead?</button>
        </div>
      </aside>

      <section class="studio-center" aria-label="Design canvas">
        <div class="stage-tools">
          <button type="button" class="icon-btn" id="btnZoomOut" title="Zoom out">−</button>
          <span class="zoom-label">Zoom</span>
          <button type="button" class="icon-btn" id="btnZoomIn" title="Zoom in">+</button>
          <button type="button" class="icon-btn" id="btnToggleGrid" title="Toggle grid" aria-pressed="false">Grid</button>
          <button type="button" class="icon-btn" id="btnForward" title="Bring forward">Layers ↑</button>
          <button type="button" class="icon-btn" id="btnBack" title="Send backward">Layers ↓</button>
          <button type="button" class="icon-btn" id="btnUndo" title="Undo">Undo</button>
          <button type="button" class="icon-btn" id="btnRedo" title="Redo">Redo</button>
          <button type="button" class="icon-btn" id="btnDelete" title="Delete selected">Delete</button>
          <label class="text-color-mini" title="Text / fill color">
            <input id="textColor" type="color" value="#ff6b2b" aria-label="Text color" />
          </label>
        </div>

        <div class="method-toggle" role="group" aria-label="Decoration method">
          <button type="button" class="method is-active" id="methodPrint" aria-pressed="true">Printing</button>
          <button type="button" class="method is-disabled" id="methodEmbroidery" aria-pressed="false" disabled title="Embroidery coming later">Embroidery</button>
        </div>

        <div class="studio-stage" id="studioStage">
          <div class="mockup-frame" id="mockupFrame">
            <img class="studio-photo" id="studioPhoto" alt="" hidden />
            <div class="studio-mockup" id="studioMockup" data-shape="tee" aria-hidden="true">
              <svg class="garment-svg" viewBox="0 0 200 240" preserveAspectRatio="xMidYMid meet">
                <path
                  id="garmentPath"
                  d="M40 42 L70 28 L85 48 L115 48 L130 28 L160 42 L175 70 L155 82 L148 70 L148 210 L52 210 L52 70 L45 82 L25 70 Z"
                  fill="currentColor"
                />
              </svg>
            </div>
            <div class="print-frame" id="printFrame">
              <canvas id="studioCanvas" width="360" height="480"></canvas>
              <div class="empty-ctas" id="emptyCtas">
                <button type="button" class="empty-cta" data-action="upload">
                  <span aria-hidden="true">↑</span> Upload image
                </button>
                <button type="button" class="empty-cta" data-action="text">
                  <span aria-hidden="true">T</span> Add text
                </button>
                <button type="button" class="empty-cta" data-action="note" id="btnDesignNote">
                  <span aria-hidden="true">✎</span> Add design note
                </button>
              </div>
            </div>
          </div>
        </div>

        <p class="studio-status" id="studioStatus" role="status"></p>
        <p class="edit-hint" id="editHint" hidden>Drag to move · drag a corner to resize · red × or Delete to remove</p>
        <ul class="studio-warnings" id="studioWarnings" hidden></ul>
      </section>

      <aside class="studio-right" aria-label="Print areas">
        <div class="right-utils">
          <a class="util" href="/contact/">Need help?</a>
          <a class="util" href="/faq/">Delivery Info</a>
          <button type="button" class="util" id="btnPreview">Preview</button>
        </div>
        <h2>Print area</h2>
        <div id="sideButtons" class="print-thumbs"></div>
      </aside>
    </div>

    <div class="product-modal" id="productDrawer" hidden>
      <div class="product-modal__backdrop" data-close-drawer></div>
      <div class="product-modal__panel" role="dialog" aria-labelledby="productDrawerTitle">
        <header>
          <h2 id="productDrawerTitle">Change your product</h2>
          <button type="button" class="icon-btn" data-close-drawer aria-label="Close">×</button>
        </header>
        <div class="product-modal__body">
          <div id="productCats" class="product-cats"></div>
          <div id="productButtons" class="product-picks"></div>
        </div>
      </div>
    </div>

    <div class="qty-modal" id="pricingPanel" hidden>
      <div class="qty-modal__backdrop" data-close-pricing></div>
      <div class="qty-modal__panel" role="dialog" aria-labelledby="pricingTitle" aria-modal="true">
        <header>
          <h2 id="pricingTitle">How Many Do You Need?</h2>
          <button type="button" class="icon-btn" data-close-pricing aria-label="Close">×</button>
        </header>
        <p class="qty-modal__label" id="sizeQtyHeading">Adult sizes</p>
        <div id="sizeQtyGrid" class="size-qty"></div>
        <p class="qty-note" id="qtyPriceNote" hidden></p>
        <div class="qty-totals">
          <div>
            <span>Total pieces</span>
            <strong id="qtyTotal">0</strong>
          </div>
          <div>
            <span>Price each</span>
            <strong class="price" id="studioPrice" data-cents={priceMap.studio_tee ?? 0}>—</strong>
          </div>
          <div>
            <span>Subtotal</span>
            <strong id="qtySubtotal">—</strong>
          </div>
        </div>
        <p class="qty-note" id="qtyDelivery">
          Same-day printing can be requested at checkout for up to 12 pieces, before 11:00am Pacific, in select Los Angeles ZIPs.
        </p>
        <label class="attest">
          <input id="ipAttest" type="checkbox" />
          <span>
            I confirm I own or have rights to this artwork, and I accept the
            <a href="/terms/">Terms</a>.
          </span>
        </label>
        <button type="button" class="btn-pricing-solid" id="btnExport">Add to cart</button>
      </div>
    </div>

    <dialog id="descDialog" class="desc-dialog">
      <form method="dialog">
        <header>
          <h2>Product Info</h2>
          <button type="submit" class="icon-btn" aria-label="Close">×</button>
        </header>
        <h3 id="descTitle"></h3>
        <p id="descBody"></p>
        <button type="button" class="text-link" id="descMore">read more</button>
        <p class="desc-label">Color</p>
        <div id="descColors" class="desc-colors"></div>
        <h3 id="descSizeHeading">Size Guide</h3>
        <div id="descSizes"></div>
      </form>
    </dialog>
  </div>
</Layout>

<script>
  import { initDesignStudio } from '../../scripts/design-studio-app.ts';
  initDesignStudio();
</script>

<style is:global>
  /* Full-bleed studio under site chrome */
  main:has(.studio-app) {
    padding: 0;
    max-width: none;
  }

  main:has(.studio-app) > .studio-app {
    max-width: none;
    margin: 0;
    padding: 0;
  }

  .studio-app {
    --studio-navy: #1b2233;
    --studio-stage: #eceef2;
    --studio-blue: #2563eb;
    display: flex;
    flex-direction: column;
    min-height: calc(100vh - 120px);
    background: var(--white);
    font-family: var(--font-body);
  }

  .studio-toolbar {
    display: flex;
    flex-wrap: wrap;
    align-items: stretch;
    gap: 0;
    background: var(--studio-navy);
    color: var(--white);
    border-bottom: 1px solid color-mix(in srgb, var(--white) 12%, transparent);
  }

  .tb-item {
    display: flex;
    flex-direction: column;
    align-items: center;
    justify-content: center;
    gap: 0.2rem;
    min-width: 4.5rem;
    padding: 0.55rem 0.75rem;
    color: var(--white);
    text-decoration: none;
    background: transparent;
    border: none;
    border-right: 1px solid color-mix(in srgb, var(--white) 12%, transparent);
    font: inherit;
    font-size: 0.7rem;
    font-weight: 600;
    cursor: pointer;
    position: relative;
  }

  .tb-item:hover,
  .tb-item:focus-visible {
    background: color-mix(in srgb, var(--white) 10%, transparent);
  }

  .tb-ico {
    font-size: 1.05rem;
    line-height: 1;
    font-family: var(--font-display);
  }

  .cart-badge {
    position: absolute;
    top: 0.35rem;
    right: 0.45rem;
    min-width: 1.1rem;
    height: 1.1rem;
    padding: 0 0.25rem;
    border-radius: 999px;
    background: var(--print-red);
    color: var(--white);
    font-size: 0.65rem;
    line-height: 1.1rem;
    text-align: center;
  }

  .tb-pricing {
    margin-left: auto;
    display: inline-flex;
    align-items: center;
    gap: 0.5rem;
    padding: 0 1.25rem;
    background: var(--studio-blue);
    color: var(--white);
    border: none;
    font-family: var(--font-display);
    font-weight: 700;
    font-size: 0.95rem;
    cursor: pointer;
    min-height: 3.25rem;
  }

  .tb-pricing:hover:not(:disabled) {
    filter: brightness(1.05);
  }

  .tb-pricing:disabled {
    background: #9aa3b2;
    cursor: not-allowed;
  }

  .studio-body {
    display: grid;
    grid-template-columns: 1fr;
    flex: 1;
    min-height: 0;
  }

  @media (min-width: 1024px) {
    .studio-body {
      grid-template-columns: 260px minmax(0, 1fr) 150px;
    }
  }

  .studio-left,
  .studio-right {
    background: var(--white);
    border-bottom: 1px solid var(--color-border);
    padding: 1rem;
  }

  @media (min-width: 1024px) {
    .studio-left {
      border-bottom: none;
      border-right: 1px solid var(--color-border);
    }
    .studio-right {
      border-bottom: none;
      border-left: 1px solid var(--color-border);
    }
  }

  .studio-left h2,
  .studio-right h2 {
    margin: 0 0 0.75rem;
    font-family: var(--font-display);
    font-size: 1.05rem;
    font-weight: 700;
  }

  .product-card {
    display: grid;
    gap: 0.5rem;
  }

  .product-thumb {
    width: 72px;
    height: 72px;
    border-radius: 6px;
    border: 1px solid var(--color-border);
    background: var(--ink);
  }

  .product-name {
    margin: 0;
    font-weight: 700;
    font-size: 0.95rem;
  }

  .product-blurb {
    margin: 0;
    font-size: 0.8rem;
    color: var(--color-muted);
  }

  .btn-outline,
  .btn-pricing-solid {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    min-height: 2.5rem;
    padding: 0.5rem 0.85rem;
    border-radius: 4px;
    font: inherit;
    font-weight: 700;
    cursor: pointer;
  }

  .btn-outline {
    background: var(--white);
    border: 1px solid var(--studio-navy);
    color: var(--studio-navy);
  }

  .btn-pricing-solid {
    width: 100%;
    background: var(--studio-blue);
    border: none;
    color: var(--white);
  }

  .text-link {
    background: none;
    border: none;
    padding: 0;
    color: var(--studio-blue);
    font: inherit;
    font-size: 0.85rem;
    font-weight: 600;
    text-align: left;
    cursor: pointer;
    text-decoration: underline;
  }

  .color-block {
    margin-top: 1.25rem;
  }

  .color-label {
    margin: 0 0 0.5rem;
    font-size: 0.85rem;
  }

  .swatches {
    display: grid;
    grid-template-columns: repeat(8, 1fr);
    gap: 0.4rem;
  }

  .swatch {
    width: 100%;
    aspect-ratio: 1;
    border-radius: 999px;
    border: 1px solid color-mix(in srgb, var(--ink) 35%, transparent);
    cursor: pointer;
    padding: 0;
  }

  .swatch.is-active {
    outline: 2px solid var(--studio-blue);
    outline-offset: 2px;
  }

  .help-box {
    margin-top: 1.5rem;
    padding: 0.85rem;
    background: color-mix(in srgb, var(--studio-blue) 8%, var(--white));
    border-radius: 6px;
    font-size: 0.85rem;
  }

  .help-box p {
    margin: 0.35rem 0 0.5rem;
  }

  .studio-center {
    display: flex;
    flex-direction: column;
    gap: 0.65rem;
    padding: 0.75rem 1rem 1.25rem;
    background: var(--studio-stage);
    min-height: 520px;
  }

  .stage-tools {
    display: flex;
    flex-wrap: wrap;
    gap: 0.35rem;
    align-items: center;
  }

  .icon-btn {
    min-height: 2rem;
    padding: 0.25rem 0.55rem;
    border: 1px solid var(--color-border-strong);
    border-radius: 4px;
    background: var(--white);
    font: inherit;
    font-size: 0.75rem;
    font-weight: 600;
    cursor: pointer;
  }

  .zoom-label {
    font-size: 0.75rem;
    font-weight: 700;
    padding: 0 0.15rem;
  }

  .icon-btn[aria-pressed='true'] {
    border-color: var(--studio-blue);
    color: var(--studio-blue);
  }

  .icon-btn.is-ready {
    background: var(--print-red);
    border-color: var(--print-red);
    color: var(--white);
  }

  .text-color-mini input {
    width: 2rem;
    height: 2rem;
    padding: 0;
    border: 1px solid var(--color-border);
    background: transparent;
    cursor: pointer;
  }

  .method-toggle {
    display: inline-flex;
    align-self: center;
    border: 1px solid var(--color-border-strong);
    border-radius: 999px;
    overflow: hidden;
    background: var(--white);
  }

  .method {
    border: none;
    background: transparent;
    padding: 0.4rem 1rem;
    font: inherit;
    font-size: 0.8rem;
    font-weight: 700;
    cursor: pointer;
  }

  .method.is-active {
    background: var(--studio-blue);
    color: var(--white);
  }

  .method.is-disabled {
    opacity: 0.45;
    cursor: not-allowed;
  }

  .studio-stage {
    position: relative;
    flex: 1;
    margin: 0 auto;
    width: min(100%, 560px);
    transform-origin: center top;
    transition: transform var(--duration-med) var(--ease-out);
  }

  .mockup-frame {
    position: relative;
    width: 100%;
    aspect-ratio: 4 / 5;
    min-height: 420px;
  }

  .mockup-frame.has-photo {
    aspect-ratio: 1;
    min-height: 0;
    background: #fff;
  }

  .studio-photo {
    display: block;
    width: 100%;
    height: 100%;
    object-fit: contain;
  }

  .studio-photo[hidden],
  .studio-mockup[hidden] {
    display: none !important;
  }

  .preview-note {
    margin: 0.65rem 0 0;
    font-size: 0.75rem;
    color: var(--color-muted);
  }

  .mockup-frame.is-grid::after {
    content: '';
    position: absolute;
    inset: 0;
    z-index: 4;
    pointer-events: none;
    background-image:
      linear-gradient(to right, rgba(37, 99, 235, 0.35) 1px, transparent 1px),
      linear-gradient(to bottom, rgba(37, 99, 235, 0.35) 1px, transparent 1px);
    background-size: 24px 24px;
  }

  .studio-mockup {
    position: absolute;
    inset: 0;
    color: #1b2233;
    display: grid;
    place-items: center;
  }

  .garment-svg {
    width: 88%;
    height: 92%;
    filter: drop-shadow(0 8px 18px color-mix(in srgb, var(--ink) 18%, transparent));
  }

  .print-frame {
    position: absolute;
    z-index: 2;
    border: 1.5px dashed color-mix(in srgb, var(--studio-blue) 80%, var(--white));
    background: color-mix(in srgb, var(--white) 42%, transparent);
    touch-action: none;
    overflow: visible;
  }

  .mockup-frame.has-photo .print-frame {
    border: 1.5px dashed rgba(255, 255, 255, 0.95);
    background: transparent;
  }

  .print-frame .canvas-container,
  .print-frame canvas {
    display: block;
    width: 100% !important;
    height: 100% !important;
  }

  .empty-ctas {
    position: absolute;
    inset: 0;
    z-index: 3;
    display: grid;
    place-content: center;
    gap: 0.5rem;
    padding: 0.75rem;
    pointer-events: none;
  }

  .empty-ctas[hidden] {
    display: none;
  }

  .empty-cta {
    pointer-events: auto;
    display: inline-flex;
    align-items: center;
    justify-content: center;
    gap: 0.45rem;
    min-width: 10rem;
    min-height: 2.4rem;
    padding: 0.45rem 0.85rem;
    border: 1px solid var(--color-border-strong);
    border-radius: 4px;
    background: var(--white);
    font: inherit;
    font-size: 0.85rem;
    font-weight: 700;
    cursor: pointer;
    box-shadow: 0 2px 8px color-mix(in srgb, var(--ink) 12%, transparent);
  }

  .empty-ctas.is-cap {
    gap: 0.4rem;
    padding: 0;
    justify-items: center;
    overflow: visible;
  }

  .empty-ctas.is-cap .empty-cta {
    min-width: 9.5rem;
    min-height: 2.35rem;
    padding: 0.45rem 0.8rem;
    font-size: 1.05rem;
    line-height: 1.2;
    white-space: nowrap;
    color: var(--ink);
  }

  .studio-status,
  .edit-hint {
    margin: 0;
    text-align: center;
    font-size: 0.85rem;
    font-weight: 600;
  }

  .edit-hint {
    color: var(--studio-navy);
  }

  .studio-warnings {
    margin: 0 auto;
    max-width: 36rem;
    padding-left: 1.1rem;
    color: var(--color-danger);
    font-size: 0.85rem;
  }

  .right-utils {
    display: grid;
    gap: 0.35rem;
    margin-bottom: 1rem;
  }

  .util {
    background: none;
    border: none;
    padding: 0;
    color: var(--studio-navy);
    font: inherit;
    font-size: 0.75rem;
    font-weight: 600;
    text-align: left;
    text-decoration: none;
    cursor: pointer;
  }

  .print-thumbs {
    display: grid;
    gap: 0.65rem;
  }

  .print-thumb {
    display: grid;
    gap: 0.25rem;
    padding: 0;
    border: 2px solid transparent;
    background: transparent;
    cursor: pointer;
    font: inherit;
    text-align: center;
  }

  .print-thumb.is-active {
    border-color: var(--studio-blue);
  }

  .print-thumb.is-designed .print-thumb__preview::after {
    content: '';
    position: absolute;
    top: 6px;
    right: 6px;
    z-index: 2;
    width: 10px;
    height: 10px;
    border-radius: 50%;
    background: #15803d;
    box-shadow: 0 0 0 2px #fff;
  }

  .print-thumb.is-disabled {
    opacity: 0.4;
    cursor: not-allowed;
  }

  .print-thumb__preview {
    width: 100%;
    aspect-ratio: 3 / 4;
    border: 1px solid var(--color-border);
    border-radius: 4px;
    background: #e7ebf0;
    position: relative;
    overflow: hidden;
    display: grid;
    place-items: center;
  }

  .print-thumb__preview svg,
  .print-thumb__preview img {
    width: 100%;
    height: 100%;
    object-fit: contain;
  }

  .print-thumb__preview span {
    position: absolute;
    border: 2px solid #f5c518;
    box-sizing: border-box;
    pointer-events: none;
  }

  .print-thumb__label {
    font-size: 0.75rem;
    font-weight: 700;
  }

  .sleeve-note {
    margin: 0.75rem 0 0;
    font-size: 0.7rem;
    color: var(--color-muted);
  }

  .drawer[hidden] {
    display: none;
  }

  .drawer {
    position: fixed;
    inset: 0;
    z-index: 80;
  }

  .drawer__backdrop {

---
import Layout from '../../layouts/Layout.astro';
import Button from '../../components/ds/Button.astro';
import { getProductBySlug, listProducts } from '../../lib/catalog';
import { formatUsd } from '../../lib/pricing';
import { claimText } from '../../lib/claims';
import { listStores } from '../../lib/stores';

export function getStaticPaths() {
  return listProducts().map((p) => ({ params: { slug: p.slug } }));
}

const { slug } = Astro.params;
const product = getProductBySlug(slug!);
if (!product) {
  return Astro.redirect('/shop/');
}

const sameDay = claimText('same-day-printing');
const sizes = [...new Set(product.variants.map((v) => v.size).filter(Boolean))];
const colors = [...new Set(product.variants.map((v) => v.color).filter(Boolean))];
const defaultVariant = product.variants[0];
const gallery =
  product.galleryUrls?.length
    ? product.galleryUrls
    : product.imageUrl
      ? [product.imageUrl]
      : [];
const storeOptions = listStores()
  .filter((store) => store.vendorId === product.vendorId)
  .map((store) => ({ slug: store.slug, name: store.name, markupBps: store.markupBps }));
---

<Layout title={product.name} description={product.description}>
  <div class="page-shell pdp">
    <p class="eyebrow"><a href="/shop/">Store</a> / {product.category}</p>
    <div class="grid">
      <div class="media">
        {
          gallery.length ? (
            <>
              <div class="media__stage">
                <img id="pdpMainImage" src={gallery[0]} alt={product.name} width="800" height="800" />
              </div>
              {gallery.length > 1 ? (
                <div class="media__thumbs" role="list" aria-label="Product photos">
                  {gallery.map((src, index) => (
                    <button
                      type="button"
                      class:list={['media__thumb', index === 0 && 'is-active']}
                      data-pdp-thumb
                      data-src={src}
                      aria-label={`View photo ${index + 1}`}
                      aria-pressed={index === 0 ? 'true' : 'false'}
                    >
                      <img src={src} alt="" width="120" height="120" loading="lazy" decoding="async" />
                    </button>
                  ))}
                </div>
              ) : null}
            </>
          ) : null
        }
      </div>
      <div class="copy">
        <h1>{product.name}</h1>
        <p class="vendor">Design by <strong>{product.vendor.name}</strong></p>
        <p class="price" id="pdpPrice">{formatUsd(defaultVariant.retailPriceCents)}</p>
        <p>{product.description}</p>
        {sameDay ? <p class="note">{sameDay}</p> : null}

        <form id="addForm" class="form">
          {
            colors.length ? (
              <label>
                Color
                <select name="color" id="colorSelect">
                  {colors.map((c) => (
                    <option value={c!}>{c}</option>
                  ))}
                </select>
              </label>
            ) : null
          }
          {
            sizes.length ? (
              <label>
                Size
                <select name="size" id="sizeSelect">
                  {sizes.map((s) => (
                    <option value={s!}>{s}</option>
                  ))}
                </select>
              </label>
            ) : null
          }
          <label>
            Qty
            <input type="number" name="qty" id="qty" min="1" max="20" value="1" />
          </label>
          <input type="hidden" id="variantId" value={defaultVariant.id} />
          <Button type="submit">Add to cart</Button>
          <p class="ok" id="addedMsg" hidden>Added — <a href="/cart/">view cart</a></p>
        </form>
      </div>
    </div>
  </div>
</Layout>

<script type="application/json" id="pdp-variants" set:html={JSON.stringify(product.variants)} />
<script type="application/json" id="pdp-stores" set:html={JSON.stringify(storeOptions)} />
<script>
  import { addToCart } from '../../scripts/cart.ts';
  import { track } from '../../scripts/analytics.ts';

  type PdpVariant = {
    id: string;
    size?: string | null;
    color?: string | null;
    retailPriceCents: number;
  };

  const raw = document.getElementById('pdp-variants')?.textContent ?? '[]';
  const variants = JSON.parse(raw) as PdpVariant[];
  const storeRaw = document.getElementById('pdp-stores')?.textContent ?? '[]';
  const storeOptions = JSON.parse(storeRaw) as Array<{ slug: string; name: string; markupBps: number }>;
  const requestedStore = new URLSearchParams(location.search).get('store') ?? '';
  const activeStore = storeOptions.find((store) => store.slug === requestedStore);

  track('view_item', { product: variants[0]?.id });

  const mainImage = document.getElementById('pdpMainImage');
  const thumbs = document.querySelectorAll<HTMLButtonElement>('[data-pdp-thumb]');
  thumbs.forEach((thumb) => {
    thumb.addEventListener('click', () => {
      const src = thumb.dataset.src;
      if (!src || !(mainImage instanceof HTMLImageElement)) return;
      mainImage.src = src;
      thumbs.forEach((t) => {
        const active = t === thumb;
        t.classList.toggle('is-active', active);
        t.setAttribute('aria-pressed', active ? 'true' : 'false');
      });
    });
  });

  const colorSelect = document.getElementById('colorSelect');
  const sizeSelect = document.getElementById('sizeSelect');
  const variantIdInput = document.getElementById('variantId');
  const priceEl = document.getElementById('pdpPrice');
  const form = document.getElementById('addForm');
  const addedMsg = document.getElementById('addedMsg');

  function resolveVariant() {
    const color = colorSelect instanceof HTMLSelectElement ? colorSelect.value : null;
    const size = sizeSelect instanceof HTMLSelectElement ? sizeSelect.value : null;
    const match =
      variants.find((v) => (!color || v.color === color) && (!size || v.size === size)) || variants[0];
    if (variantIdInput instanceof HTMLInputElement) variantIdInput.value = match.id;
    if (priceEl) {
      const cents = activeStore
        ? Math.round((match.retailPriceCents * (10000 + Math.max(0, activeStore.markupBps))) / 10000)
        : match.retailPriceCents;
      priceEl.textContent = new Intl.NumberFormat('en-US', { style: 'currency', currency: 'USD' }).format(cents / 100);
    }
    return match;
  }

  colorSelect?.addEventListener('change', resolveVariant);
  sizeSelect?.addEventListener('change', resolveVariant);
  resolveVariant();

  form?.addEventListener('submit', (event) => {
    event.preventDefault();
    const variant = resolveVariant();
    const qtyInput = document.getElementById('qty');
    const qty = qtyInput instanceof HTMLInputElement ? Number(qtyInput.value) || 1 : 1;
    addToCart(variant.id, qty, undefined, undefined, activeStore ? { storeSlug: activeStore.slug } : undefined);
    track('add_to_cart', { variantId: variant.id, quantity: qty });
    addedMsg?.removeAttribute('hidden');
  });
</script>

<style>
  .pdp .grid {
    display: grid;
    gap: 1.5rem;
  }
  @media (min-width: 900px) {
    .pdp .grid {
      grid-template-columns: 1fr 1fr;
    }
  }
  .media {
    display: grid;
    gap: 0.75rem;
  }
  .media__stage {
    background: var(--white);
    border: 1px solid var(--color-border-strong);
    border-radius: var(--radius-lg);
    overflow: hidden;
    min-height: 280px;
    aspect-ratio: 1 / 1;
  }
  .media__stage img {
    display: block;
    width: 100%;
    height: 100%;
    object-fit: cover;
  }
  .media__thumbs {
    display: grid;
    grid-template-columns: repeat(3, minmax(0, 1fr));
    gap: 0.55rem;
  }
  .media__thumb {
    appearance: none;
    margin: 0;
    padding: 0;
    border: 2px solid transparent;
    border-radius: var(--radius-md, 12px);
    overflow: hidden;
    background: var(--white);
    cursor: pointer;
    aspect-ratio: 1 / 1;
  }
  .media__thumb.is-active {
    border-color: var(--ink);
  }
  .media__thumb:focus-visible {
    outline: 3px solid var(--color-focus);
    outline-offset: 2px;
  }
  .media__thumb img {
    display: block;
    width: 100%;
    height: 100%;
    object-fit: cover;
  }
  .copy h1 {
    margin: 0 0 0.35rem;
    font-family: var(--font-display);
    letter-spacing: -0.03em;
    font-weight: 600;
    font-size: clamp(2rem, 4vw, 3rem);
  }
  .vendor {
    margin: 0 0 0.5rem;
    font-size: var(--text-sm);
    color: color-mix(in srgb, var(--ink) 80%, var(--mesh-grey));
  }
  .price {
    font-family: var(--font-mono);
    font-size: var(--text-xl);
    margin: 0 0 0.75rem;
  }
  .note {
    font-size: var(--text-sm);
    color: var(--mesh-text);
  }
  .form {
    display: grid;
    gap: 0.75rem;
    margin-top: 1rem;
    max-width: 22rem;
  }
  label {
    display: grid;
    gap: 0.35rem;
    font-weight: 600;
    font-size: var(--text-sm);
  }
  select,
  input {
    min-height: 44px;
    border: 0;
    border-radius: var(--radius-pill);
    padding: 0.5rem 0.75rem;
    font: inherit;
  }
  .ok {
    margin: 0;
    font-weight: 600;
    color: var(--color-success);
  }
  .eyebrow a {
    color: inherit;
  }
</style>

---
import RegMark from './RegMark.astro';

interface Props {
	faqHref?: string;
}

const { faqHref = '/faq' } = Astro.props;
---

<header class="site-header">
	<div class="topbar">
		Same-day service available in Los Angeles · <a href="tel:3109042655">Call (310) 904-2655</a>
	</div>
	<div class="wrap navrow">
		<a class="logo" href="/" aria-label="LiAlvaro Home">
			<RegMark />
			LiAlvaro
		</a>
		<nav class="nav-desktop" aria-label="Primary">
			<ul>
				<li><a href="/#store">Shop</a></li>
				<li><a href="/#services">Custom Printing</a></li>
				<li><a href="/about">About</a></li>
				<li><a href={faqHref}>FAQ</a></li>
			</ul>
		</nav>
		<div class="navcta">
			<a class="phone" href="tel:3109042655">(310) 904-2655</a>
			<a class="btn btn-primary btn-sm" href="/#store">Shop Now</a>
			<button
				type="button"
				class="nav-menu-toggle"
				id="site-nav-menu-toggle"
				aria-expanded="false"
				aria-controls="site-nav-mobile-panel"
				aria-label="Open menu"
			>
				<span class="nav-menu-burger" aria-hidden="true"></span>
			</button>
		</div>
	</div>

	<div
		id="site-nav-mobile-panel"
		class="nav-mobile-panel"
		role="dialog"
		aria-modal="true"
		aria-label="Menu"
		hidden
	>
		<ul class="nav-mobile-links">
			<li><a href="/#store">Shop</a></li>
			<li><a href="/#services">Custom Printing</a></li>
			<li><a href="/about">About</a></li>
			<li><a href={faqHref}>FAQ</a></li>
			<li><a href="/articles">Articles</a></li>
			<li><a href="/design-your-apparel">Design Your Apparel</a></li>
		</ul>
		<div class="nav-mobile-actions">
			<a class="btn btn-primary" href="/#store">Shop Now</a>
			<button type="button" class="btn btn-ghost" data-quote-trigger>Get a Custom Quote</button>
		</div>
	</div>
</header>

<script>
	(() => {
		const header = document.querySelector('.site-header');
		const toggle = document.getElementById('site-nav-menu-toggle');
		const panel = document.getElementById('site-nav-mobile-panel');
		if (!header || !toggle || !panel) return;

		const openLabel = 'Open menu';
		const closeLabel = 'Close menu';

		function setOpen(open: boolean) {
			toggle.setAttribute('aria-expanded', open ? 'true' : 'false');
			toggle.setAttribute('aria-label', open ? closeLabel : openLabel);
			header.classList.toggle('nav-is-open', open);
			panel.hidden = !open;
			document.body.style.overflow = open ? 'hidden' : '';
		}

		toggle.addEventListener('click', () => {
			setOpen(panel.hidden);
		});

		panel.querySelectorAll('a').forEach((a) => {
			a.addEventListener('click', () => setOpen(false));
		});

		panel.querySelectorAll('[data-quote-trigger]').forEach((el) => {
			el.addEventListener('click', () => setOpen(false));
		});

		document.addEventListener('keydown', (e) => {
			if (e.key === 'Escape' && !panel.hidden) setOpen(false);
		});

		window.addEventListener('resize', () => {
			if (window.innerWidth > 900 && !panel.hidden) setOpen(false);
		});
	})();
</script>

<style>
	.site-header {
		position: sticky;
		top: 0;
		z-index: 50;
		background: rgba(239, 235, 225, 0.92);
		backdrop-filter: blur(8px);
		border-bottom: 1px solid rgba(27, 34, 51, 0.1);
	}

	.topbar {
		background: var(--ink);
		color: var(--canvas);
		font-family: var(--font-mono);
		font-size: 12px;
		letter-spacing: 0.04em;
		text-align: center;
		padding: 7px 12px;
	}

	.topbar a {
		color: #22856c;
		font-weight: 600;
	}

	.wrap {
		max-width: var(--maxw);
		margin: 0 auto;
		padding: 0 24px;
	}

	.navrow {
		display: flex;
		align-items: center;
		justify-content: space-between;
		padding: 16px 0;
		gap: 16px;
	}

	.logo {
		font-family: var(--font-display);
		font-size: 22px;
		letter-spacing: 0.02em;
		color: var(--ink);
		display: flex;
		align-items: center;
		gap: 8px;
		text-transform: uppercase;
		text-decoration: none;
	}

	.logo :global(.regmark) {
		color: var(--brand-red);
	}

	.nav-desktop ul {
		display: flex;
		gap: 32px;
		list-style: none;
		margin: 0;
		padding: 0;
	}

	.nav-desktop a {
		font-family: var(--font-sans);
		font-size: 14px;
		font-weight: 600;
		color: var(--ink-soft);
		text-decoration: none;
	}

	.nav-desktop a:hover {
		color: var(--brand-red);
	}

	.navcta {
		display: flex;
		align-items: center;
		gap: 16px;
	}

	.phone {
		font-family: var(--font-mono);
		font-size: 13px;
		font-weight: 600;
		color: var(--ink);
		text-decoration: none;
	}

	.btn {
		display: inline-flex;
		align-items: center;
		justify-content: center;
		gap: 8px;
		font-family: var(--font-mono);
		font-size: 13px;
		font-weight: 600;
		letter-spacing: 0.03em;
		text-transform: uppercase;
		padding: 12px 22px;
		border-radius: var(--print-radius);
		border: 2px solid var(--ink);
		cursor: pointer;
		text-decoration: none;
		transition: transform 0.15s ease, background 0.15s ease, color 0.15s ease;
	}

	.btn:focus-visible {
		outline: 3px solid var(--brand-red);
		outline-offset: 2px;
	}

	.btn-primary {
		background: var(--brand-red);
		border-color: var(--brand-red);
		color: var(--paper);
	}

	.btn-primary:hover {
		background: #a80d26;
		color: var(--paper);
		transform: translateY(-1px);
	}

	.btn-ghost {
		background: transparent;
		color: var(--ink);
	}

	.btn-ghost:hover {
		background: var(--ink);
		color: var(--canvas);
	}

	.btn-sm {
		padding: 9px 16px;
		font-size: 12px;
	}

	.nav-menu-toggle {
		display: none;
		align-items: center;
		justify-content: center;
		width: 44px;
		height: 44px;
		margin: 0;
		padding: 0;
		border: none;
		background: transparent;
		cursor: pointer;
		color: var(--ink);
		flex-shrink: 0;
	}

	.nav-menu-toggle:focus-visible {
		outline: 3px solid var(--brand-red);
		outline-offset: 2px;
	}

	.nav-menu-burger {
		display: block;
		position: relative;
		width: 22px;
		height: 2px;
		background: currentColor;
		border-radius: 1px;
		box-shadow:
			0 -7px 0 currentColor,
			0 7px 0 currentColor;
	}

	.nav-mobile-panel {
		display: none;
		padding: 8px 24px 24px;
		background: var(--canvas);
		border-bottom: 1px solid rgba(27, 34, 51, 0.1);
	}

	.nav-mobile-panel:not([hidden]) {
		display: block;
	}

	.nav-mobile-links {
		list-style: none;
		margin: 0;
		padding: 0;
	}

	.nav-mobile-links a {
		display: block;
		padding: 14px 0;
		font-family: var(--font-sans);
		font-size: 16px;
		font-weight: 600;
		color: var(--ink);
		text-decoration: none;
		border-bottom: 1px solid rgba(27, 34, 51, 0.1);
	}

	.nav-mobile-links a:hover {
		color: var(--brand-red);
	}

	.nav-mobile-actions {
		display: flex;
		flex-direction: column;
		gap: 12px;
		padding-top: 20px;
	}

	.nav-mobile-actions .btn {
		width: 100%;
	}

	@media (max-width: 900px) {
		.nav-desktop,
		.phone {
			display: none;
		}

		.nav-menu-toggle {
			display: flex;
		}
	}

	@media (min-width: 901px) {
		.nav-mobile-panel {
			display: none !important;
		}
	}

	@media (prefers-reduced-motion: reduce) {
		.btn {
			transition: none;
		}
	}
</style>

---
import Layout from '../layouts/Layout.astro';
import Accordion from '../components/ds/Accordion.astro';
import Button from '../components/ds/Button.astro';
import { claimText } from '../lib/claims';

const noMinimums = claimText('no-minimums');
const turnaround = claimText('turnaround-standard-5-7');
const rush = claimText('turnaround-rush-4');
const sameDay = claimText('same-day-printing');
const delivery = claimText('la-local-delivery');
const quoteHour = claimText('quote-response-1-business-hour');
const phone = claimText('phone-310-904-2655') ?? 'Call (310) 904-2655.';
const phoneBare = phone.replace(/^Call\s+/i, '').replace(/\.$/, '');

const categories = [
  {
    id: 'orders',
    title: 'Orders & quotes',
    lede: 'How to get pricing, place an order, and what to expect on quantity.',
    items: [
      {
        id: 'quote',
        question: 'How can I get a price quote?',
        answer: `Click any “Get a Quote” button on the site and complete the quick form. You can also call us at ${phoneBare} for a fast estimate${quoteHour ? ` — ${quoteHour.replace(/\.$/, '')}` : ''}.`,
      },
      {
        id: 'order',
        question: 'How do I order a custom shirt?',
        answer:
          'Ordering starts with selecting your garment, creating or uploading your design, and choosing placement. Our team guides you through the entire process from start to finish.',
      },
      {
        id: 'minimum',
        question: "What's the minimum order quantity?",
        answer: noMinimums
          ? `${noMinimums} You can order a single shirt! That said, you benefit significantly at 12+ pieces due to bulk pricing on screen printing.`
          : 'Ask us about quantity for your project.',
      },
    ],
  },
  {
    id: 'garments',
    title: 'Garments & artwork',
    lede: 'Shirt options, file formats, and help with your design.',
    items: [
      {
        id: 'shirt-type',
        question: 'What type of shirt can I choose?',
        answer:
          'You have many brand and material options — cotton, polyester, blends, and more — as well as weight, size, and gender preferences. You may also bring your own shirts to print on.',
      },
      {
        id: 'design-help',
        question: 'Do I need to create my own design?',
        answer:
          'Not at all. We accept high-resolution files in .ai, .png, .jpg, or .svg formats. We can also edit your existing design or create a custom design for you at a small cost.',
      },
    ],
  },
  {
    id: 'production',
    title: 'Production & methods',
    lede: 'Turnaround times and choosing the right print process.',
    items: [
      {
        id: 'turnaround',
        question: 'How long does it take to get my shirts?',
        answer: [
          turnaround,
          rush,
          sameDay ? 'Same-day service is available locally in LA.' : null,
        ]
          .filter(Boolean)
          .join(' '),
      },
      {
        id: 'method',
        question: 'What printing method is right for me?',
        answer:
          'For bulk and simple designs: screen printing. For photo-quality or small batches: DTG. For versatility across fabrics: DTF. For premium branded items: embroidery. We’ll help you choose.',
      },
    ],
  },
  {
    id: 'delivery',
    title: 'Delivery & logistics',
    lede: 'Shipping, pickup, and delivery in the Los Angeles area.',
    items: [
      {
        id: 'delivery-cost',
        question: 'How much is delivery?',
        answer: delivery
          ? `${delivery} Final delivery cost depends on order size and location. Contact us for an exact quote including delivery.`
          : 'Local delivery options are available in the Los Angeles area. Final delivery cost depends on order size and location. Contact us for an exact quote including delivery.',
      },
    ],
  },
];

const faqLd = {
  '@context': 'https://schema.org',
  '@type': 'FAQPage',
  mainEntity: categories.flatMap((cat) =>
    cat.items.map((item) => ({
      '@type': 'Question',
      name: item.question,
      acceptedAnswer: { '@type': 'Answer', text: item.answer },
    })),
  ),
};
---

<Layout
  title="FAQ"
  description="Answers about custom T-shirt printing, quotes, garments, turnaround, and delivery — LiAlvaro T-Shirt Printing, Los Angeles."
  jsonLd={faqLd}
>
  <div class="faq-page">
    <header class="faq-hero">
      <div class="faq-narrow">
        <p class="faq-eyebrow">Support</p>
        <h1>Questions, answered.</h1>
        <p>
          Everything you need to know about ordering custom apparel with LiAlvaro — organized by topic so you can find
          answers fast.
        </p>
      </div>
    </header>

    <section class="faq-body">
      <div class="faq-narrow">
        {
          categories.map((cat) => (
            <article class="faq-cat" id={cat.id}>
              <div class="faq-cat__head">
                <h2>{cat.title}</h2>
                {cat.lede ? <p>{cat.lede}</p> : null}
              </div>
              <Accordion items={cat.items} />
            </article>
          ))
        }

        <section class="faq-cta">
          <h2>Ready to start your high-quality print project?</h2>
          <p>Share the project details with us — get a no-obligation quote.</p>
          <div class="faq-cta__actions">
            <button type="button" class="ds-btn ds-btn--primary" data-quote-trigger>Get a Fast, Free Quote</button>
            <Button variant="secondary" href="tel:3109042655">{phone}</Button>
          </div>
        </section>
      </div>
    </section>
  </div>
</Layout>

<style>
  .faq-page {
    background: var(--white);
  }

  .faq-narrow {
    box-sizing: border-box;
    width: min(640px, calc(100% - 2 * var(--site-gutter)));
    margin-inline: auto;
    padding-inline: var(--site-pad);
  }

  .faq-hero {
    padding: 4.5rem 0 3.25rem;
    text-align: center;
  }

  .faq-eyebrow {
    margin: 0 0 0.65rem;
    font-size: 0.75rem;
    font-weight: 600;
    letter-spacing: 0.1em;
    text-transform: uppercase;
    color: var(--print-red);
  }

  .faq-hero h1 {
    margin: 0;
    font-family: var(--font-display);
    font-size: clamp(2rem, 4vw, 2.75rem);
    font-weight: 700;
    letter-spacing: -0.03em;
    line-height: 1.15;
  }

  .faq-hero p:not(.faq-eyebrow) {
    margin: 0.85rem auto 0;
    max-width: 36rem;
    color: #6e6e73;
    font-size: 1.05rem;
    line-height: 1.55;
  }

  .faq-body {
    padding: 4.5rem 0 5.5rem;
    background: #fafafa;
  }

  .faq-cat {
    margin-bottom: 3.5rem;
  }

  .faq-cat:last-of-type {
    margin-bottom: 0;
  }

  .faq-cat__head h2 {
    margin: 0 0 0.5rem;
    font-family: var(--font-display);
    font-size: 1.375rem;
    font-weight: 700;
    letter-spacing: -0.02em;
    color: var(--ink);
  }

  .faq-cat__head p {
    margin: 0 0 1.25rem;
    font-size: 0.9375rem;
    line-height: 1.55;
    color: #6e6e73;
  }

  .faq-cta {
    margin-top: 3.5rem;
    padding: 2rem 1.5rem;
    border-radius: 20px;
    background: var(--white);
    border: 1px solid #e5e5ea;
    box-shadow: 0 4px 20px rgba(0, 0, 0, 0.04);
    text-align: center;
  }

  .faq-cta h2 {
    margin: 0;
    font-family: var(--font-display);
    font-size: clamp(1.25rem, 2.5vw, 1.5rem);
    font-weight: 700;
    letter-spacing: -0.02em;
  }

  .faq-cta p {
    margin: 0.55rem 0 0;
    color: #6e6e73;
    font-size: 0.95rem;
  }

  .faq-cta__actions {
    display: flex;
    flex-wrap: wrap;
    gap: 0.75rem;
    justify-content: center;
    margin-top: 1.15rem;
  }

  .ds-btn--primary {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    min-height: 44px;
    padding: 0.7rem 1.15rem;
    border: 0;
    border-radius: 8px;
    background: var(--print-red);
    color: var(--white);
    font-family: var(--font-body);
    font-size: var(--text-sm);
    font-weight: 600;
    cursor: pointer;
  }
</style>

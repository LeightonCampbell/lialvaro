{
	"compatibility_date": "2026-03-17",
	"compatibility_flags": [
		"global_fetch_strictly_public"
	],
	"name": "lialvaro-redesign",
	"main": "@astrojs/cloudflare/entrypoints/server",
	"assets": {
		"directory": "./dist",
		"binding": "ASSETS",
		// Boolean true breaks `astro dev`: Vite modules + public/ assets 404
		// (worker catches /* before Vite). Asset-first still hits the Worker for
		// SSR/API routes with no matching static file. Use path patterns only if
		// a specific route must run before assets.
		"run_worker_first": [
			"/api/*",
			"/account/*",
			"/admin/*",
			"/auth/*",
			"/cart/*",
			"/checkout/*"
		]
		// Do not set html_handling force-trailing-slash here: in `astro dev` the
		// Cloudflare Vite plugin appends "/" to static asset URLs (e.g. /images/x.jpg/)
		// and they 404. Page trailing slashes stay in src/middleware.ts.
	},
	"observability": {
		"enabled": true
	},
	"d1_databases": [
		{
			"binding": "DB",
			"database_name": "lialvaro-commerce",
			"database_id": "26c850ff-29cb-434b-a9fa-08b3fe577b99",
			"migrations_dir": "migrations"
		}
	],
	"kv_namespaces": [
		{
			"binding": "SESSION",
			"id": "5494cbe612244c9fa752e080e10d8145"
		}
	],
	"images": {
		"binding": "IMAGES"
	}
}

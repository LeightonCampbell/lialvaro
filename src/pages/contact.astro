---
import Layout from '../layouts/Layout.astro';
import Button from '../components/ds/Button.astro';
import { claimText } from '../lib/claims';

const phone = claimText('phone-310-904-2655') ?? 'Call (310) 904-2655.';
const email = claimText('email-help') ?? 'Email help@lialvaro.com.';
const sameDay = claimText('same-day-printing');
const losAngeles = claimText('los-angeles');
---

<Layout
  title="Contact"
  description="Contact LiAlvaro T-Shirt Printing in Los Angeles for quotes, design help, and custom apparel projects."
>
  <div class="page-shell">
    <header class="page-hero">
      <p class="eyebrow">Contact</p>
      <h1>Let’s talk project.</h1>
      <p>Got an idea? Need a quote? Call or email — we’re happy to help.</p>
    </header>

    <div class="contact-grid">
      <article class="card">
        <h2>Call us</h2>
        <p>The fastest way to get clarity on timing and pricing.</p>
        <Button href="tel:3109042655">{phone}</Button>
      </article>
      <article class="card">
        <h2>Email</h2>
        <p>Send project details and files when that is easier.</p>
        <Button variant="secondary" href="mailto:help@lialvaro.com">{email}</Button>
      </article>
      <article class="card">
        <h2>Los Angeles</h2>
        <p>{losAngeles ?? 'Serving customers from Los Angeles, California.'}</p>
        {sameDay ? <p class="note">{sameDay}</p> : null}
        <button type="button" class="linkish" data-quote-trigger>Get a free quote →</button>
      </article>
    </div>

    <section class="quote-band">
      <h2>Prefer a form?</h2>
      <p>Request a free quote — no obligation.</p>
      <button type="button" class="ds-btn ds-btn--primary" data-quote-trigger>Get a free quote</button>
    </section>
  </div>
</Layout>

<style>
  .contact-grid {
    display: grid;
    gap: 1rem;
  }

  @media (min-width: 800px) {
    .contact-grid {
      grid-template-columns: repeat(3, 1fr);
    }
  }

  .card {
    background: var(--white);
    border: 1px solid var(--color-border-strong);
    border-radius: var(--radius-lg);
    padding: 1.5rem;
    display: grid;
    gap: 0.75rem;
    align-content: start;
  }

  .card h2 {
    margin: 0;
    font-size: var(--text-xl);
  }

  .card p {
    margin: 0;
    color: color-mix(in srgb, var(--ink) 80%, var(--mesh-grey));
  }

  .note {
    font-size: var(--text-sm);
  }

  .quote-band {
    margin-top: 2.5rem;
    padding: 1.75rem;
    text-align: center;
    background: var(--white);
    border: 1px solid var(--color-border-strong);
    border-radius: var(--radius-lg);
  }

  .quote-band h2 {
    margin: 0;
    font-family: var(--font-display);
    text-transform: uppercase;
    font-weight: 600;
  }

  .quote-band p {
    margin: 0.5rem 0 1rem;
  }

  .ds-btn--primary {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    min-height: 44px;
    padding: 0.7rem 1.15rem;
    border: 2px solid var(--print-red);
    border-radius: var(--radius-md);
    background: var(--print-red);
    color: var(--white);
    font-family: var(--font-body);
    font-size: var(--text-sm);
    font-weight: 700;
    cursor: pointer;
  }

  .linkish {
    background: none;
    border: none;
    color: var(--print-red);
    font: inherit;
    font-weight: 700;
    text-decoration: underline;
    cursor: pointer;
    min-height: 44px;
    justify-self: start;
    padding: 0;
  }
</style>

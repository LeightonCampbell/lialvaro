---
interface Step {
  title: string;
  body: string;
}

interface Props {
  steps: Step[];
  class?: string;
}

const { steps, class: className = '' } = Astro.props;
---

<ol class:list={['ds-steps', className]}>
  {
    steps.length === 0 ? (
      <li class="ds-steps__empty">No steps yet.</li>
    ) : (
      steps.map((step, i) => (
        <li class="ds-steps__item">
          <span class="ds-steps__num" aria-hidden="true">{i + 1}</span>
          <div>
            <h3 class="ds-steps__title">{step.title}</h3>
            <p class="ds-steps__body">{step.body}</p>
          </div>
        </li>
      ))
    )
  }
</ol>

<style>
  .ds-steps {
    list-style: none;
    margin: 0;
    padding: 0;
    display: grid;
    gap: var(--space-4);
  }

  @media (min-width: 768px) {
    .ds-steps {
      grid-template-columns: repeat(3, 1fr);
      gap: var(--space-5);
    }
  }

  .ds-steps__item {
    display: grid;
    grid-template-columns: auto 1fr;
    gap: var(--space-3);
    padding: var(--space-4);
    background: var(--white);
    border: 1px solid var(--color-border);
    border-radius: var(--radius-md);
  }

  .ds-steps__num {
    width: 2rem;
    height: 2rem;
    display: grid;
    place-items: center;
    border: 1px solid var(--ink);
    border-radius: 50%;
    font-family: var(--font-mono);
    font-size: var(--text-sm);
    font-weight: 500;
  }

  .ds-steps__title {
    margin: 0 0 var(--space-1);
    font-size: var(--text-md);
    font-weight: 700;
  }

  .ds-steps__body {
    margin: 0;
    font-size: var(--text-sm);
    color: color-mix(in srgb, var(--ink) 80%, var(--mesh-grey));
    line-height: var(--leading-normal);
  }

  .ds-steps__empty {
    color: var(--mesh-text);
  }
</style>

---
import RegMark from './RegMark.astro';
---

<footer class="site-footer">
	<div class="wrap foot-grid">
		<div>
			<a class="logo" href="/">
				<RegMark />
				LiAlvaro
			</a>
			<p>
				Los Angeles&rsquo; premier custom apparel printer. Premium quality, no minimums, same-day service.
			</p>
		</div>
		<div>
			<h4>Shop</h4>
			<ul>
				<li><a href="/#store">All Products</a></li>
				<li><a href="/#services">Custom Printing</a></li>
				<li><a href="/design-your-apparel">Design Your Apparel</a></li>
			</ul>
		</div>
		<div>
			<h4>Company</h4>
			<ul>
				<li><a href="/about">About Us</a></li>
				<li><a href="/faq">FAQ</a></li>
				<li><a href="/articles">Articles</a></li>
				<li><a href="/contact">Contact</a></li>
			</ul>
		</div>
		<div>
			<h4>Contact</h4>
			<ul>
				<li><a href="tel:3109042655">(310) 904-2655</a></li>
				<li><a href="/contact">Los Angeles, CA</a></li>
			</ul>
		</div>
	</div>
	<div class="wrap foot-bottom">
		<span>&copy; 2026 LiAlvaro Apparel. All Rights Reserved.</span>
		<span>Privacy Policy · Terms of Service</span>
	</div>
</footer>

<style>
	.site-footer {
		background: var(--ink);
		color: #b7bac4;
		padding: 56px 0 28px;
		margin-top: 24px;
	}

	.wrap {
		max-width: var(--maxw);
		margin: 0 auto;
		padding: 0 24px;
	}

	.foot-grid {
		display: grid;
		grid-template-columns: 1.4fr 1fr 1fr 1fr;
		gap: 32px;
	}

	.logo {
		font-family: var(--font-display);
		font-size: 22px;
		letter-spacing: 0.02em;
		color: var(--canvas);
		display: inline-flex;
		align-items: center;
		gap: 8px;
		text-transform: uppercase;
		text-decoration: none;
		margin-bottom: 10px;
	}

	.logo :global(.regmark) {
		color: var(--brand-red);
	}

	.site-footer p {
		font-family: var(--font-sans);
		font-size: 14px;
		max-width: 32ch;
		margin: 14px 0 0;
		color: #b7bac4;
		line-height: 1.55;
	}

	.site-footer h4 {
		font-family: var(--font-mono);
		font-size: 12px;
		letter-spacing: 0.08em;
		text-transform: uppercase;
		color: var(--canvas);
		margin: 0 0 14px;
		font-weight: 600;
	}

	.site-footer ul {
		list-style: none;
		margin: 0;
		padding: 0;
		display: flex;
		flex-direction: column;
		gap: 9px;
	}

	.site-footer a {
		font-size: 14px;
		color: #b7bac4;
		text-decoration: none;
		font-family: var(--font-sans);
	}

	.site-footer a:hover {
		color: var(--canvas);
	}

	.foot-bottom {
		border-top: 1px solid rgba(255, 255, 255, 0.12);
		margin-top: 40px;
		padding-top: 20px;
		display: flex;
		justify-content: space-between;
		font-family: var(--font-mono);
		font-size: 12px;
		flex-wrap: wrap;
		gap: 10px;
	}

	@media (max-width: 800px) {
		.foot-grid {
			grid-template-columns: 1fr 1fr;
		}
	}

	@media (max-width: 560px) {
		.foot-grid {
			grid-template-columns: 1fr;
		}
	}
</style>

---
import Layout from '../../layouts/Layout.astro';
import ProductCard from '../../components/ds/ProductCard.astro';
import Button from '../../components/ds/Button.astro';
import { claimText } from '../../lib/claims';
import { listProducts, productCardPrice } from '../../lib/catalog';

const sameDay = claimText('same-day-printing');
const category = Astro.url.searchParams.get('category') ?? 'all';
const products = listProducts(category === 'all' ? undefined : category);
---

<Layout
  title="Shop"
  description="Shop standard products from LiAlvaro T-Shirt Printing. Need bulk or custom? Request a quote."
>
  <div class="page-shell">
    <header class="page-hero">
      <p class="eyebrow">Store</p>
      <h1>Shop</h1>
      <p>Standard products with listed prices. Need bulk or something custom? Request a quote.</p>
      {sameDay ? <p class="note">{sameDay}</p> : null}
    </header>

    <div class="filters" role="group" aria-label="Product filters">
      <a class:list={['chip', category === 'all' && 'is-active']} href="/shop/">All</a>
      <a class:list={['chip', category === 'apparel' && 'is-active']} href="/shop/?category=apparel">Apparel</a>
      <a class:list={['chip', category === 'headwear' && 'is-active']} href="/shop/?category=headwear"
        >Headwear &amp; accessories</a
      >
    </div>

    <div class="grid">
      {
        products.length ? (
          products.map((product) => (
            <ProductCard
              title={product.name}
              href={`/shop/${product.slug}/`}
              price={productCardPrice(product)}
              badge={product.category}
            />
          ))
        ) : (
          <ProductCard empty />
        )
      }
    </div>

    <div class="actions">
      <button type="button" class="ds-btn ds-btn--primary" data-quote-trigger>Get a custom quote →</button>
      <Button variant="ghost" href="/design/">Start Designing</Button>
    </div>
  </div>
</Layout>

<style>
  .note {
    margin: 0.75rem 0 0;
    font-size: var(--text-sm);
    color: var(--mesh-text);
  }

  .filters {
    display: flex;
    flex-wrap: wrap;
    gap: 0.5rem;
    margin-bottom: 1.25rem;
  }

  .chip {
    border: 1px solid var(--color-border-strong);
    border-radius: var(--radius-sm);
    padding: 0.4rem 0.7rem;
    font-size: var(--text-sm);
    background: var(--white);
    color: inherit;
    text-decoration: none;
    min-height: 44px;
    display: inline-flex;
    align-items: center;
  }

  .chip.is-active {
    border-color: var(--ink);
    font-weight: 700;
  }

  .grid {
    display: grid;
    gap: 1rem;
  }

  @media (min-width: 800px) {
    .grid {
      grid-template-columns: repeat(3, 1fr);
    }
  }

  .actions {
    display: flex;
    flex-wrap: wrap;
    gap: 0.75rem;
    margin-top: 1.5rem;
  }

  .actions .ds-btn--primary {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    min-height: 44px;
    padding: 0.7rem 1.15rem;
    border: 2px solid var(--print-red);
    border-radius: var(--radius-md);
    background: var(--print-red);
    color: var(--white);
    font-family: var(--font-body);
    font-size: var(--text-sm);
    font-weight: 700;
    cursor: pointer;
  }
</style>

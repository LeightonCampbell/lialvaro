---
import { claimText } from '../../lib/claims';

interface NavItem {
  label: string;
  href: string;
}

interface Props {
  items?: NavItem[];
  /** Signed-in account email. When set, the header shows an avatar instead of a text label. */
  accountEmail?: string;
  class?: string;
}

const {
  items = [
    { label: 'Shop', href: '/shop/' },
    { label: 'Services', href: '/#services' },
    { label: 'Design Studio', href: '/design/' },
    { label: 'FAQs', href: '/faq/' },
  ],
  accountEmail,
  class: className = '',
} = Astro.props;

const signedIn = Boolean(accountEmail);
const accountLabel = signedIn ? 'Account' : 'Sign in';
const avatarInitial = (accountEmail?.trim()[0] ?? 'A').toUpperCase();
const avatarColor = '#22856c';
const showQuoteTab = !Astro.url.pathname.startsWith('/design');
const sameDay = claimText('same-day-printing');
const phoneClaim = claimText('phone-310-904-2655');
---

<div class:list={['ds-chrome', className]}>
  {
    sameDay || phoneClaim ? (
      <div class="ds-topbar">
        <div class="ds-topbar__inner">
          <p class="ds-topbar__msg">
            {sameDay ? 'Same-day printing available for select LA orders' : 'Custom apparel printing in Los Angeles'}
            {phoneClaim ? (
              <>
                {' '}
                · <a href="tel:3109042655">(310) 904-2655</a>
              </>
            ) : null}
          </p>
          <a class="ds-topbar__cta" href="/shop/">Shop Now</a>
        </div>
      </div>
    ) : null
  }

  <header class="ds-header">
    <div class="ds-header__inner">
      <a class="ds-header__brand" href="/">
        <img
          class="ds-header__logo"
          src="/brand/logo.png"
          alt="LiAlvaro"
          width="200"
          height="50"
          decoding="async"
        />
      </a>

      <nav class="ds-header__nav" aria-label="Primary">
        <ul class="ds-header__list">
          {
            items.map((item) => (
              <li>
                <a class="ds-header__link" href={item.href}>
                  {item.label}
                </a>
              </li>
            ))
          }
        </ul>
      </nav>

      <div class="ds-header__actions">
        <a class="ds-header__cart" href="/cart/" aria-label="Cart">
          <svg class="ds-header__cart-icon" viewBox="0 0 24 24" width="22" height="22" aria-hidden="true">
            <path
              d="M7.2 7.2h12.1l-1.1 8.1a1.6 1.6 0 0 1-1.6 1.4H9.4a1.6 1.6 0 0 1-1.6-1.3L6.2 4.8H3.5"
              fill="none"
              stroke="currentColor"
              stroke-width="1.7"
              stroke-linecap="round"
              stroke-linejoin="round"
            />
            <circle cx="10" cy="19.2" r="1.25" fill="currentColor" />
            <circle cx="16.4" cy="19.2" r="1.25" fill="currentColor" />
          </svg>
        </a>

        <a class="ds-header__hotline" href="tel:3109042655">
          <span class="ds-header__hotline-label">Hotline</span>
          <span class="ds-header__hotline-num">(310) 904-2655</span>
        </a>

        {
          signedIn ? (
            <a class="ds-header__account ds-header__avatar" href="/account/" aria-label="Account" style={`--avatar:${avatarColor}`}>
              <span aria-hidden="true">{avatarInitial}</span>
            </a>
          ) : (
            <a class="ds-header__account" href="/account/" aria-label={accountLabel}>
              <svg viewBox="0 0 24 24" width="22" height="22" aria-hidden="true">
                <circle cx="12" cy="8.2" r="3.2" fill="none" stroke="currentColor" stroke-width="1.7" />
                <path d="M5.5 18.5c1.6-2.6 3.8-3.9 6.5-3.9s4.9 1.3 6.5 3.9" fill="none" stroke="currentColor" stroke-width="1.7" stroke-linecap="round" />
              </svg>
            </a>
          )
        }

        <button class="ds-header__quote" type="button" data-quote-trigger>Get a quote</button>

        <button class="ds-header__menu-btn" type="button" aria-expanded="false" aria-controls="ds-mobile-menu" data-ds-menu-toggle>
          Menu
        </button>
      </div>
    </div>

    <div class="ds-mobile-menu" id="ds-mobile-menu" hidden>
      <nav aria-label="Mobile">
        <ul class="ds-mobile-menu__list">
          {
            items.map((item) => (
              <li>
                <a href={item.href}>{item.label}</a>
              </li>
            ))
          }
          <li><a href="/account/">{accountLabel}</a></li>
          <li><a href="tel:3109042655">(310) 904-2655</a></li>
          <li><button type="button" data-quote-trigger>Get a quote</button></li>
        </ul>
      </nav>
    </div>
  </header>
</div>

{
  showQuoteTab ? (
    <button class="quote-tab" type="button" data-quote-trigger>
      <span class="quote-tab__dot" aria-hidden="true"></span>
      <span class="quote-tab__label">Get a Free Quote</span>
    </button>
  ) : null
}

<script>
  const toggle = document.querySelector('[data-ds-menu-toggle]');
  const menu = document.getElementById('ds-mobile-menu');
  toggle?.addEventListener('click', () => {
    const open = menu?.hasAttribute('hidden') ?? true;
    if (!menu || !(toggle instanceof HTMLButtonElement)) return;
    if (open) {
      menu.removeAttribute('hidden');
      toggle.setAttribute('aria-expanded', 'true');
    } else {
      menu.setAttribute('hidden', '');
      toggle.setAttribute('aria-expanded', 'false');
    }
  });
</script>

<style>
  .ds-chrome {
    position: sticky;
    top: 0;
    z-index: 30;
  }

  .ds-topbar {
    background: linear-gradient(90deg, #dff5ec 0%, #eef8f4 50%, #e4f3ff 100%);
    color: var(--ink);
  }

  .ds-topbar__inner {
    box-sizing: border-box;
    width: min(var(--site-max), calc(100% - 2 * var(--site-gutter)));
    margin-inline: auto;
    padding: 0.55rem var(--site-pad);
    display: flex;
    align-items: center;
    justify-content: center;
    gap: 0.85rem;
    flex-wrap: wrap;
    text-align: center;
  }

  .ds-topbar__msg {
    margin: 0;
    font-size: 0.875rem;
    font-weight: 500;
  }

  .ds-topbar__msg a {
    color: var(--studio-green);
    font-weight: 600;
    text-decoration: none;
  }

  .ds-topbar__cta {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    min-height: 30px;
    padding: 0 0.9rem;
    border-radius: 8px;
    background: var(--white);
    color: var(--ink);
    font-size: 0.8rem;
    font-weight: 600;
    text-decoration: none;
    box-shadow: 0 1px 2px color-mix(in srgb, var(--ink) 8%, transparent);
  }

  .ds-header {
    background: var(--white);
    border-bottom: 1px solid color-mix(in srgb, var(--ink) 6%, transparent);
  }

  .ds-header__inner {
    position: relative;
    box-sizing: border-box;
    width: min(var(--site-max), calc(100% - 2 * var(--site-gutter)));
    margin-inline: auto;
    min-height: 74px;
    padding: 0 var(--site-pad);
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: var(--space-3);
  }

  .ds-header__brand {
    display: inline-flex;
    align-items: center;
    flex: 0 0 auto;
    text-decoration: none;
    line-height: 0;
  }

  .ds-header__logo {
    display: block;
    height: 36px;
    width: auto;
  }

  .ds-header__brand:focus-visible,
  .ds-header__account:focus-visible,
  .ds-header__cart:focus-visible,
  .ds-header__quote:focus-visible,
  .ds-header__hotline:focus-visible,
  .quote-tab:focus-visible {
    outline: 3px solid var(--color-focus);
    outline-offset: 2px;
  }

  .ds-header__nav {
    display: none;
  }

  .ds-header__list {
    display: flex;
    align-items: center;
    gap: 1.6rem;
    list-style: none;
    margin: 0;
    padding: 0;
  }

  .ds-header__link,
  .ds-header__account,
  .ds-header__cart {
    color: var(--ink);
    text-decoration: none;
    font-weight: 500;
    font-size: 0.95rem;
  }

  .ds-header__link:hover,
  .ds-header__account:hover,
  .ds-header__cart:hover,
  .ds-header__hotline:hover {
    color: var(--studio-green);
  }

  .ds-header__avatar {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    width: 36px;
    height: 36px;
    padding: 0;
    border-radius: 50%;
    background: var(--avatar, #22856c);
    color: var(--white);
    font-size: 0.95rem;
    font-weight: 600;
    line-height: 1;
    letter-spacing: 0;
    flex: none;
  }

  .ds-header__avatar:hover {
    color: var(--white);
    filter: brightness(0.94);
  }

  .ds-header__actions {
    display: flex;
    align-items: center;
    gap: 0.85rem;
    flex: 0 0 auto;
  }

  .ds-header__cart,
  .ds-header__account:not(.ds-header__avatar) {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    width: 40px;
    height: 40px;
    border-radius: 50%;
    color: var(--ink);
  }

  .ds-header__cart-icon {
    display: block;
    flex: none;
  }

  .ds-header__hotline {
    display: none;
    flex-direction: column;
    line-height: 1.15;
    text-decoration: none;
    color: var(--ink);
  }

  .ds-header__hotline-label {
    font-size: 0.68rem;
    letter-spacing: 0.08em;
    text-transform: uppercase;
    color: var(--mesh-text);
    font-weight: 500;
  }

  .ds-header__hotline-num {
    font-size: 0.92rem;
    font-weight: 700;
  }

  .ds-header__quote {
    display: none;
    align-items: center;
    justify-content: center;
    min-height: 42px;
    padding: 0 1.15rem;
    border: 0;
    border-radius: 8px;
    background: var(--ink);
    color: var(--white);
    font-family: var(--font-body);
    font-size: 0.9rem;
    font-weight: 600;
    cursor: pointer;
  }

  .ds-header__quote:hover {
    background: #000;
  }

  .ds-header__menu-btn {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    min-height: 42px;
    padding: 0 1rem;
    border: 0;
    border-radius: 8px;
    background: var(--studio-soft);
    font-weight: 600;
    cursor: pointer;
  }

  .ds-header__menu-btn:focus-visible {
    outline: 3px solid var(--color-focus);
    outline-offset: 2px;
  }

  @media (min-width: 960px) {
    .ds-header__nav {
      display: block;
      position: absolute;
      left: 50%;
      top: 50%;
      transform: translate(-50%, -50%);
    }

    .ds-header__hotline,
    .ds-header__quote {
      display: inline-flex;
    }

    .ds-header__menu-btn {
      display: none;
    }
  }

  .ds-mobile-menu {
    box-sizing: border-box;
    width: min(var(--site-max), calc(100% - 2 * var(--site-gutter)));
    margin: 0 auto;
    padding: var(--space-4) var(--site-pad);
    background: var(--white);
    border-bottom: 1px solid color-mix(in srgb, var(--ink) 8%, transparent);
  }

  .ds-mobile-menu__list {
    list-style: none;
    margin: 0;
    padding: 0;
    display: grid;
    gap: var(--space-2);
  }

  .ds-mobile-menu__list a,
  .ds-mobile-menu__list button {
    display: flex;
    align-items: center;
    min-height: 44px;
    color: var(--ink);
    font-weight: 600;
    text-decoration: none;
    background: none;
    border: none;
    padding: 0;
    font: inherit;
    cursor: pointer;
    text-align: left;
  }

  .ds-mobile-menu__list a:focus-visible,
  .ds-mobile-menu__list button:focus-visible {
    outline: 3px solid var(--color-focus);
    outline-offset: 2px;
  }

  .quote-tab {
    display: none;
  }

  @media (min-width: 960px) {
    .quote-tab {
      display: flex;
      flex-direction: column;
      align-items: center;
      gap: 0.7rem;
      position: fixed;
      top: 50%;
      right: 0;
      transform: translateY(-50%);
      z-index: 40;
      margin: 0;
      padding: 0.75rem 0.55rem 1rem;
      border: 0;
      border-radius: 8px 0 0 8px;
      background: var(--studio-green);
      color: #fff;
      font-family: var(--font-body);
      font-size: 0.95rem;
      font-weight: 700;
      line-height: 1;
      cursor: pointer;
      box-shadow: -6px 0 18px color-mix(in srgb, var(--ink) 16%, transparent);
    }

    .quote-tab:hover {
      background: var(--studio-green-dark);
    }
  }

  .quote-tab__dot {
    width: 8px;
    height: 8px;
    border-radius: 50%;
    background: #f5b301;
    flex: none;
  }

  .quote-tab__label {
    writing-mode: vertical-rl;
    transform: rotate(180deg);
  }
</style>

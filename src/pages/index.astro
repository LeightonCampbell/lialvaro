---
import Layout from '../layouts/Layout.astro';
import Button from '../components/ds/Button.astro';
import ProductCard from '../components/ds/ProductCard.astro';
import Accordion from '../components/ds/Accordion.astro';
import { brand, claimText } from '../lib/claims';
import { listProducts, productCardPrice } from '../lib/catalog';

const featured = listProducts().slice(0, 5);

const sameDay = claimText('same-day-printing');
const methods = claimText('methods-screen-dtg-dtf-embroidery');
const noMinimums = claimText('no-minimums');
const turnaround = claimText('turnaround-standard-5-7');
const freeQuote = claimText('free-quote');
const quoteHour = claimText('quote-response-1-business-hour');
const phone = claimText('phone-310-904-2655') ?? 'Call (310) 904-2655.';

const trustItems = (
  [
    turnaround ? { label: 'Rapid turnaround', icon: 'clock' } : null,
    noMinimums ? { label: 'No minimums', icon: 'stack' } : null,
    { label: 'Easy Design Studio', icon: 'design' },
    freeQuote ? { label: 'Free quote', icon: 'quote' } : null,
    sameDay ? { label: 'Same-day in LA', icon: 'bolt' } : null,
  ] as Array<{ label: string; icon: string } | null>
).filter((item): item is { label: string; icon: string } => Boolean(item));

const steps = [
  {
    title: 'Start Designing',
    body: 'Open Design Studio, pick a product, and add your art.',
    image: '/images/dtg.jpg',
    alt: 'Custom design on apparel',
  },
  {
    title: 'Approve art & pricing',
    body: 'Confirm the proof and total before we print.',
    image: '/images/silkscreen.jpg',
    alt: 'Artwork review and print setup',
  },
  {
    title: 'We print & deliver',
    body: 'Choose pickup or delivery',
    image: '/images/screenprinting.jpg',
    alt: 'Finished printed apparel',
  },
];

const whyUs = (
  [
    methods
      ? {
          title: 'Print quality that lasts',
          body: 'Screen, DTG, DTF, or embroidery — matched to the garment and the job.',
        }
      : null,
    {
      title: 'Easy online design',
      body: 'Place art, pick sizes, and add to cart in Design Studio when you are ready.',
    },
    turnaround
      ? {
          title: 'Clear timing',
          body: sameDay
            ? 'Standard 5–7 business days after approval. Same-day available for select LA orders.'
            : 'Standard turnaround is 5–7 business days after artwork approval and payment.',
        }
      : null,
    quoteHour
      ? {
          title: 'Help when you need it',
          body: 'We typically respond to quote requests within one business hour.',
        }
      : null,
    noMinimums
      ? {
          title: 'No minimum order',
          body: noMinimums,
        }
      : null,
    freeQuote
      ? {
          title: 'Free custom quote',
          body: 'Tell us quantity, garment, and timing — we’ll recommend a path.',
        }
      : null,
  ] as Array<{ title: string; body: string } | null>
).filter((item): item is { title: string; body: string } => Boolean(item));

const favorites = [
  {
    title: 'Birthday t-shirts',
    blurb: 'Celebrate in print — design online and order.',
    image: '/images/most-requested-birthday.png',
    href: '/design/',
    quote: false,
    cta: 'Customize',
  },
  {
    title: 'Team Jerseys',
    blurb: 'Names, numbers, and roster runs.',
    image: '/images/most-requested-jersey.jpg',
    href: null,
    quote: true,
    cta: 'Get a quote',
  },
  {
    title: 'Hoodies',
    blurb: 'Soft layers with your art up front.',
    image: '/images/most-requested-hoodie.jpg',
    href: '/design/',
    quote: false,
    cta: 'Customize',
  },
  {
    title: 'School uniforms',
    blurb: 'Campus and program apparel at scale.',
    image: '/images/most-requested-uniform.png',
    href: null,
    quote: true,
    cta: 'Get a quote',
  },
];

const methodCards = [
  { label: 'Screen Printing', service: 'Screen Printing', image: '/images/screenprinting.jpg' },
  { label: 'DTG', service: 'Direct to Garment', image: '/images/dtg.jpg' },
  { label: 'DTF', service: 'Direct to Film', image: '/images/direct-to-film.jpg' },
  { label: 'Embroidery', service: 'Embroidery', image: '/images/embroidery-hat.jpg' },
];

const reviews = [
  {
    name: 'Leighton C.',
    quote:
      "I had my logo designed and my t-shirts and polos printed here several years ago. Since then, I've had banners, posters, hats, and, many other products done by LTP. Li is so friendly and patient.",
  },
  {
    name: 'Mark L.',
    quote: 'I will never use another company for my Custom Printing needs. These guys do a wonderful job.',
  },
  {
    name: 'Richard L.',
    quote:
      'Truly 5 stars - This was so easy, even for my large, complicated order. Li guided me through the process and was super responsive. The shirts are comfortable, the design is perfect.',
  },
];

const faqItems = [
  {
    id: 'shop-vs-quote',
    question: 'Design Studio vs quote?',
    answer:
      'Design Studio is for orders you are ready to place. A quote is for bulk, specialty garments, or projects that need a custom plan.',
  },
  {
    id: 'minimums',
    question: 'Minimum order?',
    answer: noMinimums ?? 'Ask us about quantity for your project.',
  },
  {
    id: 'how-fast',
    question: 'How fast?',
    answer: [turnaround, sameDay].filter(Boolean).join(' ') || 'Call us to confirm timing for your order.',
  },
];

const localBusiness = {
  '@context': 'https://schema.org',
  '@type': 'LocalBusiness',
  name: brand,
  url: 'https://www.lialvaro.com/',
  telephone: '+1-310-904-2655',
  email: 'help@lialvaro.com',
  address: {
    '@type': 'PostalAddress',
    addressLocality: 'Los Angeles',
    addressRegion: 'CA',
    addressCountry: 'US',
  },
  areaServed: 'Los Angeles',
  description:
    'Custom apparel printing in Los Angeles — screen printing, DTG, DTF, and embroidery. Design online or request a quote.',
};

const faqPageLd = {
  '@context': 'https://schema.org',
  '@type': 'FAQPage',
  mainEntity: faqItems.map((item) => ({
    '@type': 'Question',
    name: item.question,
    acceptedAnswer: { '@type': 'Answer', text: item.answer },
  })),
};
---

<Layout
  title="Custom T-Shirt Printing in Los Angeles"
  description="Custom printed apparel with a clear process. Design online or request a quote. LiAlvaro T-Shirt Printing — Los Angeles."
  keywords="custom t-shirt printing Los Angeles, screen printing, DTG, DTF, embroidery"
  jsonLd={[localBusiness, faqPageLd]}
>
  <div class="studio-home">
    <!-- 1. Hero -->
    <section class="studio-hero">
      <div class="studio-wrap studio-hero__grid">
        <div class="studio-hero__copy">
          <p class="studio-hero__badge">Create your own</p>
          <h1>
            <span class="studio-hero__line">Fast, Easy, High&#8209;Quality</span>
            <span class="studio-hero__line">Custom Apparel Printing</span>
          </h1>
          <svg class="studio-hero__scribble" viewBox="0 0 180 18" aria-hidden="true">
            <path
              d="M3 11c28-10 52 6 78-2 24-7 48 4 72-3 8-2 18-1 24 2"
              fill="none"
              stroke="currentColor"
              stroke-width="3"
              stroke-linecap="round"
            ></path>
          </svg>
          <p class="studio-hero__sub">
            {(methods ??
              'We offer screen printing, direct-to-garment (DTG), direct-to-film (DTF), and embroidery.') +
              ' LiAlvaro · Los Angeles'}
          </p>
          <div class="studio-hero__ctas">
            <a class="studio-btn studio-btn--green" href="/design/">Start Designing</a>
            <button type="button" class="studio-btn studio-btn--ghost" data-quote-trigger>Get a free quote</button>
          </div>
        </div>

        <div class="studio-hero__visual" aria-hidden="true">
          <div class="studio-hero__orb"></div>
          <div class="studio-hero__dots"></div>
          <img
            class="studio-hero__photo"
            src="/images/wolf.jpg"
            alt=""
            width="720"
            height="900"
            fetchpriority="high"
            decoding="async"
          />
          <div class="studio-hero__swatches">
            <span style="background:#c9b6e4"></span>
            <span class="is-active" style="background:#22856c"></span>
            <span style="background:#ffb39a"></span>
            <span style="background:#7b5ea7"></span>
          </div>
          <div class="studio-hero__mini">
            <img src="/images/homepage-hero-2.jpg" alt="" width="120" height="120" loading="lazy" decoding="async" />
          </div>
        </div>
      </div>
    </section>

    <!-- 2. Trust strip -->
    {
      trustItems.length ? (
        <section class="studio-trust" aria-label="Why customers choose LiAlvaro">
          <div class="studio-wrap">
            <ul class="studio-trust__list">
              {trustItems.map((item) => (
                <li>
                  <span class="studio-trust__icon" aria-hidden="true">
                    {item.icon === 'clock' ? (
                      <svg viewBox="0 0 24 24" width="22" height="22" fill="none" stroke="currentColor" stroke-width="1.6">
                        <circle cx="12" cy="12" r="8"></circle>
                        <path d="M12 8v4.5l2.5 1.5" stroke-linecap="round"></path>
                      </svg>
                    ) : null}
                    {item.icon === 'stack' ? (
                      <svg viewBox="0 0 24 24" width="22" height="22" fill="none" stroke="currentColor" stroke-width="1.6">
                        <path d="M4 8h16M6 12h12M8 16h8" stroke-linecap="round"></path>
                      </svg>
                    ) : null}
                    {item.icon === 'design' ? (
                      <svg viewBox="0 0 24 24" width="22" height="22" fill="none" stroke="currentColor" stroke-width="1.6">
                        <path d="M5 19l4-1 9.5-9.5a2.1 2.1 0 0 0-3-3L6 15l-1 4z" stroke-linejoin="round"></path>
                      </svg>
                    ) : null}
                    {item.icon === 'quote' ? (
                      <svg viewBox="0 0 24 24" width="22" height="22" fill="none" stroke="currentColor" stroke-width="1.6">
                        <path d="M7 17h4l2 3V8H5v9h2zm10 0h4l2 3V8h-8v9h2z" stroke-linejoin="round"></path>
                      </svg>
                    ) : null}
                    {item.icon === 'bolt' ? (
                      <svg viewBox="0 0 24 24" width="22" height="22" fill="none" stroke="currentColor" stroke-width="1.6">
                        <path d="M13 3L5 14h6l-1 7 9-12h-6l0-6z" stroke-linejoin="round"></path>
                      </svg>
                    ) : null}
                  </span>
                  <span>{item.label}</span>
                </li>
              ))}
            </ul>
          </div>
        </section>
      ) : null
    }

    <!-- 3. Quote band -->
    <section class="studio-quote-band">
      <div class="studio-wrap">
        <blockquote>
          “I will never use another company for my Custom Printing needs. These guys do a wonderful job.”
        </blockquote>
        <p class="studio-quote-band__by">— Mark L.</p>
      </div>
    </section>

    <!-- 4. How it works -->
    <section class="studio-section studio-section--white">
      <div class="studio-wrap">
        <header class="studio-section__head studio-section__head--center">
          <h2>How to create custom prints</h2>
          <p>Three simple steps from Design Studio to your finished product — no runaround.</p>
        </header>
        <ol class="studio-steps">
          {
            steps.map((step, index) => (
              <li class="studio-step">
                <div class="studio-step__media">
                  <img src={step.image} alt={step.alt} width="420" height="280" loading="lazy" decoding="async" />
                  <span class="studio-step__num" aria-hidden="true">{index + 1}</span>
                </div>
                <h3>{step.title}</h3>
                <p>{step.body}</p>
              </li>
            ))
          }
        </ol>
      </div>
    </section>

    <!-- 5. Free & easy / Design Studio -->
    <section class="studio-section studio-section--soft">
      <div class="studio-wrap studio-split">
        <div class="studio-split__copy">
          <h2>Free and easy way to bring your ideas to life</h2>
          <p>
            Open Design Studio, setup your artwork, pick sizes, and add to cart to place your order.
          </p>
          <a class="studio-btn studio-btn--green" href="/design/">Get Started</a>
        </div>
        <div class="studio-split__visual studio-split__visual--mint">
          <img src="/images/dtg.jpg" alt="" width="640" height="480" loading="lazy" decoding="async" />
        </div>
      </div>
    </section>

    <!-- 6. Methods -->
    <section class="studio-section studio-section--soft" id="services">
      <div class="studio-wrap">
        <header class="studio-section__head studio-section__head--center">
          <h2>T-shirt printing made easy.</h2>
          <p>
            {
              methods
                ? `${methods} Tell us about quantity, garment, and timing — we’ll recommend a path.`
                : 'Tell us about quantity, garment, and timing — we’ll recommend a path.'
            }
          </p>
        </header>
        <div class="studio-methods">
          {
            methodCards.map((method) => (
              <button
                type="button"
                class="studio-method"
                data-quote-trigger
                data-quote-service={method.service}
              >
                <img src={method.image} alt="" width="320" height="220" loading="lazy" decoding="async" />
                <span>{method.label}</span>
              </button>
            ))
          }
        </div>
      </div>
    </section>

    <!-- 7. Store picks -->
    <section class="studio-section studio-section--white">
      <div class="studio-wrap">
        <header class="studio-section__head studio-section__head--center">
          <h2>Our picks for you</h2>
          <p>
            Browse vendor designs we print and fulfill. For bulk jobs,
            <button type="button" class="studio-inline-quote" data-quote-trigger>
              <strong><u>Get a quote</u></strong>
            </button>
            instead.
          </p>
        </header>
        <div class="studio-products">
          {
            featured.length ? (
              featured.map((product) => (
                <ProductCard
                  title={product.name}
                  href={`/shop/${product.slug}/`}
                  price={productCardPrice(product)}
                  image={product.imageUrl ?? undefined}
                  hoverImage={product.hoverImageUrl ?? undefined}
                  centered
                />
              ))
            ) : (
              <ProductCard empty />
            )
          }
        </div>
        <div class="studio-section__cta">
          <a class="studio-btn studio-btn--dark" href="/shop/">Browse the store</a>
        </div>
      </div>
    </section>

    <!-- 8. Why us -->
    {
      whyUs.length ? (
        <section class="studio-section studio-section--soft">
          <div class="studio-wrap studio-why">
            <div class="studio-why__copy">
              <h2>Why customize products with LiAlvaro?</h2>
              <p>Built for clear results — from one-off designs to roster runs.</p>
              <ul class="studio-why__list">
                {whyUs.map((item) => (
                  <li>
                    <h3>{item.title}</h3>
                    <p>{item.body}</p>
                  </li>
                ))}
              </ul>
              <button type="button" class="studio-btn studio-btn--green" data-quote-trigger>View quote options</button>
            </div>
            <aside class="studio-why__card">
              <div class="studio-why__card-body">
                <p class="studio-why__card-kicker">Create your own</p>
                <h3>custom products online!</h3>
                <p>Free and easy way to bring your ideas to life</p>
                <a class="studio-btn studio-btn--dark" href="/design/">Order in Design Studio</a>
              </div>
              <img src="/images/wolf.jpg" alt="" width="360" height="280" loading="lazy" decoding="async" />
            </aside>
          </div>
        </section>
      ) : null
    }

    <!-- 9. Favorites / resources -->
    <section class="studio-section studio-section--white">
      <div class="studio-wrap">
        <header class="studio-section__head studio-section__head--center">
          <h2>Most requested</h2>
          <p>Pick a path — design online now, or request a quote for bulk and specialty work.</p>
        </header>
        <div class="studio-favorites">
          {
            favorites.map((item) => (
              <article class="studio-fav">
                <div class="studio-fav__media">
                  <img src={item.image} alt="" width="480" height="360" loading="lazy" decoding="async" />
                </div>
                <div class="studio-fav__body">
                  <h3>{item.title}</h3>
                  <p>{item.blurb}</p>
                  {item.quote ? (
                    <button type="button" class="studio-btn studio-btn--green studio-btn--block" data-quote-trigger>
                      {item.cta}
                    </button>
                  ) : (
                    <a class="studio-btn studio-btn--green studio-btn--block" href={item.href ?? '/design/'}>
                      {item.cta}
                    </a>
                  )}
                </div>
              </article>
            ))
          }
        </div>
      </div>
    </section>

    <!-- 10. Reviews -->
    <section class="studio-section studio-section--soft">
      <div class="studio-wrap">
        <header class="studio-section__head studio-section__head--center">
          <h2>What People Are Saying</h2>
          <p>Real reviews from customers who printed with LiAlvaro.</p>
        </header>
        <div class="studio-reviews">
          {
            reviews.map((review) => (
              <figure class="studio-review">
                <blockquote>“{review.quote}”</blockquote>
                <figcaption>{review.name}</figcaption>
              </figure>
            ))
          }
        </div>
      </div>
    </section>

    <!-- 11. Dual promo -->
    <section class="studio-dual">
      <div class="studio-wrap studio-dual__grid">
        <article class="studio-dual__card studio-dual__card--lilac">
          <h2>Ready to design online?</h2>
          <p>Open Design Studio and place an order when you are ready.</p>
          <a class="studio-btn studio-btn--dark" href="/design/">Start Designing</a>
          <img src="/images/dtg.jpg" alt="" width="280" height="200" loading="lazy" decoding="async" />
        </article>
        <article class="studio-dual__card studio-dual__card--mint">
          <h2>Need a custom plan?</h2>
          <p>Bulk, specialty, or method-led jobs — request a free quote.</p>
          <button type="button" class="studio-btn studio-btn--dark" data-quote-trigger>Get a free quote</button>
          <img src="/images/screenprinting.jpg" alt="" width="280" height="200" loading="lazy" decoding="async" />
        </article>
      </div>
    </section>

    <!-- 12. FAQ -->
    <section class="studio-section studio-section--white" id="faq">
      <div class="studio-wrap studio-faq">
        <header class="studio-section__head">
          <h2>Quick answers</h2>
          <p>Common questions before you design or request a quote.</p>
        </header>
        <Accordion items={faqItems} />
        <div class="studio-section__cta studio-section__cta--start">
          <Button href="/faq/">View the full FAQ →</Button>
        </div>
      </div>
    </section>

    <!-- 13. Final CTA -->
    <section class="studio-final">
      <div class="studio-wrap">
        <h2>Ready when you are.</h2>
        <p>Questions? Call us — we’re happy to help.</p>
        <div class="studio-final__ctas">
          <button type="button" class="studio-btn studio-btn--green" data-quote-trigger>Get a free quote</button>
          <a class="studio-btn studio-btn--ghost-dark" href="tel:3109042655">{phone}</a>
        </div>
      </div>
    </section>
  </div>
</Layout>

<style>
  .studio-home {
    --studio-radius: 18px;
    --studio-radius-sm: 10px;
    color: var(--ink);
    background: var(--white);
  }

  .studio-wrap {
    box-sizing: border-box;
    width: min(1240px, calc(100% - 2 * var(--site-gutter)));
    margin-inline: auto;
    padding-inline: var(--site-pad);
  }

  .studio-btn {
    box-sizing: border-box;
    display: inline-flex;
    align-items: center;
    justify-content: center;
    min-height: 48px;
    padding: 0 1.35rem;
    border: 1px solid transparent;
    border-radius: 8px;
    font-family: var(--font-body);
    font-size: 0.95rem;
    font-weight: 500;
    line-height: 1.2;
    text-decoration: none;
    cursor: pointer;
    transition:
      background 160ms var(--ease-out),
      color 160ms var(--ease-out),
      border-color 160ms var(--ease-out),
      transform 160ms var(--ease-out);
  }

  .studio-btn:hover {
    transform: translateY(-1px);
  }

  .studio-btn--green {
    background: var(--studio-green);
    border-color: var(--studio-green);
    color: #fff;
  }

  .studio-btn--green:hover {
    background: var(--studio-green-dark);
    border-color: var(--studio-green-dark);
  }

  .studio-btn--dark {
    background: var(--ink);
    border-color: var(--ink);
    color: #fff;
  }

  .studio-btn--ghost {
    background: transparent;
    border-color: color-mix(in srgb, #fff 45%, transparent);
    color: #fff;
  }

  .studio-btn--ghost:hover {
    background: color-mix(in srgb, #fff 10%, transparent);
  }

  .studio-btn--ghost-dark {
    background: transparent;
    border-color: color-mix(in srgb, var(--ink) 18%, transparent);
    color: var(--ink);
  }

  .studio-btn--block {
    width: 100%;
  }

  /* Hero */
  .studio-hero {
    position: relative;
    overflow: hidden;
    background: #0a0a0a;
    color: #fff;
  }

  .studio-hero__grid {
    display: grid;
    gap: 2rem;
    align-items: center;
    min-height: min(78vh, 760px);
    padding-block: 3.5rem 2.5rem;
  }

  @media (min-width: 960px) {
    .studio-hero__grid {
      grid-template-columns: minmax(0, 1.05fr) minmax(0, 0.95fr);
      gap: 2.5rem;
      padding-block: 4rem 3rem;
    }
  }

  .studio-hero__copy {
    position: relative;
    z-index: 2;
    display: grid;
    justify-items: center;
    text-align: center;
    gap: 1rem;
    max-width: 36rem;
    margin-inline: auto;
  }

  @media (min-width: 960px) {
    .studio-hero__copy {
      justify-items: start;
      text-align: left;
      margin-inline: 0;
    }
  }

  .studio-hero__badge {
    margin: 0;
    display: inline-flex;
    align-items: center;
    min-height: 30px;
    padding: 0 0.85rem;
    border-radius: 999px;
    background: color-mix(in srgb, var(--studio-lilac-deep) 35%, #000);
    color: #e8d9ff;
    font-size: 0.82rem;
    font-weight: 500;
  }

  .studio-hero h1 {
    margin: 0;
    display: grid;
    gap: 0.08em;
    font-family: var(--font-display);
    font-size: clamp(2.35rem, 5vw, 3.65rem);
    font-weight: 700;
    letter-spacing: -0.035em;
    line-height: 1.08;
  }

  .studio-hero__line {
    display: block;
  }

  .studio-hero__scribble {
    width: min(180px, 55%);
    height: auto;
    color: var(--studio-green);
    margin-top: -0.25rem;
  }

  .studio-hero__sub {
    margin: 0;
    max-width: 32rem;
    color: color-mix(in srgb, #fff 72%, #9a9a9a);
    font-size: 1.05rem;
    line-height: 1.55;
  }

  .studio-hero__ctas {
    display: flex;
    flex-wrap: wrap;
    justify-content: center;
    gap: 0.75rem;
    margin-top: 0.35rem;
    width: min(100%, 28rem);
  }

  @media (min-width: 960px) {
    .studio-hero__ctas {
      justify-content: flex-start;
    }
  }

